{
  "info": {
    "name": "PRAMAAN Partner API",
    "description": "Reseller integration endpoints. Set the `baseUrl` and `apiKey` collection variables, then start with Meta → Verify a key. Generated from the OpenAPI spec by scripts/generate-partner-postman.ts — do not edit by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://your-host.example"
    },
    {
      "key": "apiKey",
      "value": "pk_live_replace_me"
    }
  ],
  "item": [
    {
      "name": "me",
      "item": [
        {
          "name": "Verify a key",
          "request": {
            "method": "GET",
            "description": "Returns the account a key authenticates as and the scopes it holds. Requires no scope — use it to check credentials during setup.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "qc-results",
      "item": [
        {
          "name": "List QC results",
          "request": {
            "method": "GET",
            "description": "QC results visible to the key owner, newest first. Scope: `qc:read`.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/qc-results",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "qc-results"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "",
                  "description": "Page size, 1–200 (default 50).",
                  "disabled": true
                },
                {
                  "key": "offset",
                  "value": "",
                  "description": "Rows to skip (default 0).",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Free text over serial, model and machine id.",
                  "disabled": true
                },
                {
                  "key": "machineId",
                  "value": "",
                  "description": "Restrict to one machine.",
                  "disabled": true
                },
                {
                  "key": "startDate",
                  "value": "",
                  "description": "Inclusive lower bound, `YYYY-MM-DD`.",
                  "disabled": true
                },
                {
                  "key": "endDate",
                  "value": "",
                  "description": "Inclusive upper bound, `YYYY-MM-DD`.",
                  "disabled": true
                },
                {
                  "key": "grades",
                  "value": "",
                  "description": "Comma-separated grade buckets, e.g. `A+,A,B`.",
                  "disabled": true
                },
                {
                  "key": "overallPass",
                  "value": "",
                  "description": "`true` for passing reports only.",
                  "disabled": true
                },
                {
                  "key": "since",
                  "value": "",
                  "description": "Incremental sync cursor: an ISO timestamp (e.g. `2026-08-18T10:00:00Z`). Returns everything recorded at or after it, ignoring the default retention window. Inclusive — pair it with `sort=date_asc` and de-duplicate on `id`.",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "",
                  "description": "`date_desc` (default), `date_asc`, `grade_desc`, `grade_asc`, `id_asc`.",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Count QC results",
          "request": {
            "method": "GET",
            "description": "Lifetime total for the account. Honours `machineId`, `search`, `userId` and `overallPass` only — **date, `since` and retention filters do not apply here**. For a filtered total, read `pagination.total` from the list endpoint instead. Scope: `qc:read`.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/qc-results/count",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "qc-results",
                "count"
              ],
              "query": [
                {
                  "key": "machineId",
                  "value": "",
                  "description": "Restrict to one machine.",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Free text over serial, model and machine id.",
                  "disabled": true
                },
                {
                  "key": "overallPass",
                  "value": "",
                  "description": "`true` for passing reports only.",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get a QC result",
          "request": {
            "method": "GET",
            "description": "One result with its individual test rows. Scope: `qc:read`.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/qc-results/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "qc-results",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "QC result id."
                }
              ]
            }
          }
        },
        {
          "name": "Issue summary",
          "request": {
            "method": "GET",
            "description": "Device-issue counts over the latest report per machine. Scope: `qc:read`.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/qc-results/issues-summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "qc-results",
                "issues-summary"
              ]
            }
          }
        },
        {
          "name": "Asset-health summary",
          "request": {
            "method": "GET",
            "description": "Storage, thermal and tamper risk buckets. Scope: `qc:read`.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/qc-results/asset-health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "qc-results",
                "asset-health"
              ]
            }
          }
        },
        {
          "name": "Hide a QC result",
          "request": {
            "method": "DELETE",
            "description": "Removes a result from every listing. The row is retained and certificates already issued stay verifiable. Scope: `qc:write`.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/qc-results/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "qc-results",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "QC result id."
                }
              ]
            }
          }
        },
        {
          "name": "Export QC results",
          "request": {
            "method": "GET",
            "description": "Latest report per machine as a file — the only endpoint that does not answer with JSON. Scope: `reports:read`.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/qc-results/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "qc-results",
                "export"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "",
                  "description": "`xlsx` (default) or `pdf`.",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Free text filter, as on the list.",
                  "disabled": true
                },
                {
                  "key": "timeZone",
                  "value": "",
                  "description": "IANA zone for rendered dates, e.g. `Asia/Kolkata`.",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    },
