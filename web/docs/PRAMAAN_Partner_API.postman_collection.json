        {
          "name": "Generate a license key",
          "request": {
            "method": "POST",
            "description": "Mints a key against the account's license credits, honouring its duration and platform permissions exactly as the dashboard does. Scope: `licenses:write`. Roles: Reseller, Refurbisher, Enterprise.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/partner/v1/licenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "partner",
                "v1",
                "licenses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"yearly\",\n  \"product_scope\": [\n    \"windows\"\n  ],\n  \"platform_caps\": {\n    \"windows\": 2\n  }\n}"
            }
          }
        },
        {
          "name": "Update a license key",
          "request": {
            "method": "PATCH",
            "description": "Activate or deactivate a key, or move its expiry. Send one field or the other. Scope: `licenses:write`. Roles: Reseller, Refurbisher, Enterprise.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
