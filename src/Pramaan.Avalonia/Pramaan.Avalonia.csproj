<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Use Exe so the entry point is cross-platform (not WinExe which is Windows-only) -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Windows-only: UAC manifest for admin elevation -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- macOS: .app bundle metadata -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <CFBundleName>PRAMAAN</CFBundleName>
    <CFBundleIdentifier>com.pramaan.qctool</CFBundleIdentifier>
    <CFBundleShortVersionString>1.0.0</CFBundleShortVersionString>
    <CFBundleVersion>1.0.0</CFBundleVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaptopQC.Core\LaptopQC.Core.csproj" />
    <ProjectReference Include="..\LaptopQC.Hardware\LaptopQC.Hardware.csproj" />
  </ItemGroup>

  <!-- macOS: Bundle a static smartctl binary so SMART drive health works without Homebrew.
       Place a universal (arm64 + x86_64) smartctl binary at:
         src/Pramaan.Avalonia/runtimes/osx/smartctl
       The file is .gitignored by default (binary). Copy it manually to the source dir before publishing.
       The binary is marked CopyToOutputDirectory=PreserveNewest so it appears next to the .exe
       at runtimes/osx/smartctl, which is where MacSmartTestService looks first. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="runtimes\osx\smartctl" Condition="Exists('runtimes\osx\smartctl')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes/osx/smartctl</TargetPath>
    </Content>
  </ItemGroup>
</Project>
