<Window x:Class="Pramaan.Avalonia.Views.QCWizardWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pramaan.Avalonia.ViewModels"
        xmlns:conv="using:Pramaan.Avalonia.Converters"
        Title="QC Wizard" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        CanResize="False">

    <Window.DataContext>
        <vm:QCWizardViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:GradeToColorConverter x:Key="GradeToColorConverter"/>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <conv:BoolToPassFailConverter x:Key="BoolToPassFailConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Primary Purple Button matching WPF -->
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A3376"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.PrimaryButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#6B2C67"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Secondary / Outline Button -->
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontFamily" Value="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SecondaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e5e7eb"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
        <Style Selector="Button.SecondaryButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#d1d5db"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Styles>

    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="16" Padding="24" MaxHeight="700"
            BoxShadow="0 4 6 0 #1A000000">
        <Grid>
            <!-- Step 1: Preparation -->
            <StackPanel IsVisible="{Binding IsPrepStep}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Step 1: Preparation" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Refurbish ID / Asset Tag:" Margin="0,8" Foreground="#374151" FontFamily="Segoe UI"/>
                <TextBox Text="{Binding RefurbId, Mode=TwoWay}"
                         Padding="12,10" FontFamily="Segoe UI" FontSize="14"
                         Background="#f9fafb" BorderBrush="#d1d5db" BorderThickness="1"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Technician Notes (Optional):" Margin="0,8" Foreground="#374151" FontFamily="Segoe UI"/>
                <TextBox Text="{Binding TechnicianNotes}" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                         Padding="12,10" FontFamily="Segoe UI" FontSize="14"
                         Background="#f9fafb" BorderBrush="#d1d5db" BorderThickness="1"
                         Margin="0,0,0,24"/>

                <Button Command="{Binding StartTestsCommand}" Content="Start QC Process"
                        Classes="PrimaryButton" Height="44" FontSize="14"/>
            </StackPanel>

            <!-- Step 2: Automated Tests -->
            <StackPanel IsVisible="{Binding IsAutomatedStep}"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Step 2: Automated System Checks" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <ProgressBar Value="{Binding AutomatedProgress}" Height="10"
                             Background="#e5e7eb" Foreground="#8B3D88" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding AutomatedStatus}" HorizontalAlignment="Center" FontSize="14" Foreground="#6b7280" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Step 3: Interactive Tests -->
            <StackPanel IsVisible="{Binding IsInteractiveStep}"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🧪" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Step 3: Interactive Tests" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding InteractiveInstruction}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,24" Foreground="#6C6B6B" FontFamily="Segoe UI"/>

                <Button Command="{Binding RunKeyboardTestCommand}" Content="Run Keyboard Test"
                        Classes="PrimaryButton"
                        IsVisible="{Binding IsKeyboardNext}"
                        Height="50" Margin="0,8" FontSize="14"/>

                <Button Command="{Binding RunTrackpadTestCommand}" Content="Run Trackpad Test"
                        Classes="PrimaryButton"
                        IsVisible="{Binding IsTrackpadNext}"
                        Height="50" Margin="0,8" FontSize="14"/>

                <Button Command="{Binding RunUsbTestCommand}" Content="Run USB Port Test"
                        Classes="PrimaryButton"
                        IsVisible="{Binding IsUsbNext}"
                        Height="50" Margin="0,8" FontSize="14"/>

                <Button Command="{Binding RunAvTestCommand}" Content="Run Audio &amp; Video Test"
                        Classes="PrimaryButton"
                        IsVisible="{Binding IsAvNext}"
                        Height="50" Margin="0,8" FontSize="14"/>

                <!-- WiFi / Network Test -->
                <StackPanel IsVisible="{Binding IsWifiNext}">
                    <TextBlock Text="Connect this machine to WiFi and/or plug in an Ethernet cable."
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,8"
                               Foreground="#6b7280" FontSize="13" FontFamily="Segoe UI"/>

                    <!-- Live connection status — WiFi + Ethernet -->
                    <Border Background="#f3f4f6" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                            Padding="14,10" Margin="0,4,0,12" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- WiFi -->
                            <TextBlock Text="{Binding IsWifiLiveConnected, Converter={StaticResource BoolToPassFailConverter}}"
                                       Foreground="{Binding IsWifiLiveConnected, Converter={StaticResource BoolToColorConverter}}"
                                       FontFamily="Segoe UI" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding WifiLiveStatusText}" Foreground="#1f2937" FontFamily="Segoe UI" Margin="0,0,12,0"/>

                            <!-- Separator -->
                            <TextBlock Text=" | " Foreground="#6b7280" Margin="0,0,12,0"/>

                            <!-- Ethernet -->
                            <TextBlock Text="{Binding IsEthernetLiveConnected, Converter={StaticResource BoolToPassFailConverter}}"
                                       Foreground="{Binding IsEthernetLiveConnected, Converter={StaticResource BoolToColorConverter}}"
                                       FontFamily="Segoe UI" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding EthernetLiveStatusText}" Foreground="#1f2937" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding RunWifiTestCommand}" Content="🌐 Test Network Connectivity"
                            Classes="PrimaryButton"
                            Height="50" Margin="0,4" FontSize="14"/>
                </StackPanel>

                <!-- Network check status (shown while/after testing) -->
                <TextBlock Text="{Binding WifiStatus}"
                           IsVisible="{Binding IsCheckingNetwork}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="14" Foreground="#0891b2" FontFamily="Segoe UI"/>
                <TextBlock Text="{Binding WifiStatus}"
                           IsVisible="{Binding NetworkCheckDone}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Step 4: Report -->
            <StackPanel IsVisible="{Binding IsReportStep}"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="✓" FontFamily="Segoe UI" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#15803d"/>
                    <TextBlock Text="QC Complete" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Checkmark visual (static in Avalonia — animation requires code-behind) -->
                <Border Width="90" Height="90" Margin="0,0,0,10" HorizontalAlignment="Center"
                        BorderBrush="#15803d" BorderThickness="5" CornerRadius="16">
                    <TextBlock Text="✓" FontSize="44" Foreground="#15803d"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </Border>

                <TextBlock Text="{Binding CompletionMessage}" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI"
                           Foreground="{Binding OverallGrade, Converter={StaticResource GradeToColorConverter}}"/>

                <!-- QR Code section -->
                <StackPanel IsVisible="{Binding HasQrCode, FallbackValue=False}" Margin="0,12,0,16" HorizontalAlignment="Center">
                    <TextBlock Text="PRAMAAN Certification Verification" HorizontalAlignment="Center" FontSize="12" Foreground="#6b7280" Margin="0,0,0,4"/>
                    <Border BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="4" Padding="6" Background="White">
                        <Image Source="{Binding QrCodeImage}" Width="110" Height="110"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding ReportPath}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#9ca3af" FontSize="11" FontFamily="Segoe UI"/>

                <TextBlock Text="{Binding SubmissionStatus}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,24"
                           Foreground="{Binding SubmissionStatusColor, FallbackValue='#15803d'}" FontFamily="Segoe UI"/>

                <Button Command="{Binding OpenReportCommand}" Content="View Report"
                        Classes="PrimaryButton" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
