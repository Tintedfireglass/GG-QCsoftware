<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pramaan.Avalonia.ViewModels"
        x:Class="Pramaan.Avalonia.Views.TrackpadTestWindow"
        Title="🖱️ Trackpad Test" 
        Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        CanResize="False"
        PointerMoved="Window_PointerMoved"
        PointerPressed="Window_PointerPressed"
        PointerWheelChanged="Window_PointerWheelChanged">
    
    <Window.DataContext>
        <vm:TrackpadTestViewModel />
    </Window.DataContext>
    
    <Window.Styles>
        <Style Selector="Border.testItem">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
        <Style Selector="Border.tested">
            <Setter Property="Background" Value="#dcfce7"/>
            <Setter Property="BorderBrush" Value="#22c55e"/>
        </Style>

        <Style Selector="TextBlock.testItemLabel">
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.testedLabel">
            <Setter Property="Foreground" Value="#15803d"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.testItemIcon">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
        </Style>
        <Style Selector="TextBlock.testedIcon">
            <Setter Property="Foreground" Value="#22c55e"/>
        </Style>
        
        <!-- Cancel button -->
        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cancelBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e5e7eb"/>
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        <Style Selector="Button.cancelBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#d1d5db"/>
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        
        <!-- Green complete button -->
        <Style Selector="Button.completeBtn">
            <Setter Property="Background" Value="#22c55e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.completeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#16a34a"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.completeBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#15803d"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
    
    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="16" Padding="20"
            BoxShadow="0 4 6 0 #1A000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="Trackpad Test" 
                           FontSize="22" FontWeight="SemiBold" 
                           Foreground="#22c55e" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Progress Bar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Minimum="0" Maximum="100"
                             Height="8" 
                             Background="#e5e7eb"
                             Foreground="#22c55e"/>
                <TextBlock Text="{Binding ProgressText}" 
                           Foreground="#6b7280" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <!-- Test Area -->
            <Border Grid.Row="2" Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Test Status Indicators -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                        <!-- Movement -->
                        <Border Classes="testItem" Classes.tested="{Binding MovementTested}">
                            <StackPanel>
                                <TextBlock Text="Move" Classes="testItemIcon" Classes.testedIcon="{Binding MovementTested}" />
                                <TextBlock Text="Movement" Classes="testItemLabel" Classes.testedLabel="{Binding MovementTested}" />
                            </StackPanel>
                        </Border>
                        
                        <!-- Left Click -->
                        <Border Classes="testItem" Classes.tested="{Binding LeftClickTested}">
                            <StackPanel>
                                <TextBlock Text="L" Classes="testItemIcon" Classes.testedIcon="{Binding LeftClickTested}" />
                                <TextBlock Text="Left Click" Classes="testItemLabel" Classes.testedLabel="{Binding LeftClickTested}" />
                            </StackPanel>
                        </Border>
                        
                        <!-- Right Click -->
                        <Border Classes="testItem" Classes.tested="{Binding RightClickTested}">
                            <StackPanel>
                                <TextBlock Text="R" Classes="testItemIcon" Classes.testedIcon="{Binding RightClickTested}" />
                                <TextBlock Text="Right Click" Classes="testItemLabel" Classes.testedLabel="{Binding RightClickTested}" />
                            </StackPanel>
                        </Border>
                        
                        <!-- Scroll -->
                        <Border Classes="testItem" Classes.tested="{Binding ScrollTested}">
                            <StackPanel>
                                <TextBlock Text="Scroll" Classes="testItemIcon" Classes.testedIcon="{Binding ScrollTested}" />
                                <TextBlock Text="Scroll" Classes="testItemLabel" Classes.testedLabel="{Binding ScrollTested}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    
                    <!-- Interactive Test Zone -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" 
                            BorderBrush="#d1d5db" BorderThickness="2">
                        <TextBlock Text="Move cursor and click here to test trackpad" 
                                   Foreground="#9ca3af" FontFamily="Segoe UI"
                                   FontSize="15"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Instructions -->
            <TextBlock Grid.Row="3" 
                       Text="{Binding Instructions}" 
                       Foreground="#6b7280" FontFamily="Segoe UI"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Cancel" 
                        Command="{Binding CancelTestCommand}"
                        Width="120" Height="40"
                        Margin="0,0,16,0"
                        Classes="cancelBtn"/>
                
                <Button Content="Complete Test" 
                        Command="{Binding CompleteTestCommand}"
                        Width="150" Height="40"
                        Classes="completeBtn"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
