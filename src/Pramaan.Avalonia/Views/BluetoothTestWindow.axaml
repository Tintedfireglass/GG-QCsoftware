<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pramaan.Avalonia.Views.BluetoothTestWindow"
        Title="Bluetooth Test" Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#f5f5f5">

    <Window.Styles>
        <Style Selector="Button.primaryBtn">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A3376"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primaryBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#5C2B5C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primaryBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#9ca3af"/>
            <Setter Property="Foreground" Value="#e5e7eb"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Background="White"
                BorderBrush="#e5e7eb"
                BorderThickness="1"
                CornerRadius="12"
                Margin="20"
                Padding="30"
                BoxShadow="0 4 6 0 #1A000000">
            <StackPanel>
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#eff6ff" CornerRadius="50" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🔵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Bluetooth Test" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#1f2937" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"/>
                    <TextBlock Text="Checking Bluetooth adapter and scanning for devices..."
                               FontSize="12" Foreground="#6b7280" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Background="#e5e7eb" Foreground="#8B3D88"/>
                    <TextBlock x:Name="LoadingText" Text="Scanning Bluetooth adapter..."
                               HorizontalAlignment="Center" Foreground="#6b7280" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"
                               FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Results -->
                <StackPanel x:Name="ResultsPanel" IsVisible="False" Margin="0,0,0,16">

                    <!-- Adapter Status -->
                    <Border Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AdapterIcon" Text="📡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Bluetooth Adapter" FontWeight="SemiBold" Foreground="#1f2937" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif" FontSize="13"/>
                                <TextBlock x:Name="AdapterStatusText" Text="-" Foreground="#6b7280" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Discovery Scan Status -->
                    <Border Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScanIcon" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Radio Scan" FontWeight="SemiBold" Foreground="#1f2937" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif" FontSize="13"/>
                                <TextBlock x:Name="ScanStatusText" Text="-" Foreground="#6b7280" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Overall Result -->
                    <Border x:Name="OverallResultBorder" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock x:Name="OverallResultText" HorizontalAlignment="Center"
                                   FontWeight="SemiBold" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif" FontSize="13"/>
                    </Border>
                </StackPanel>

                <!-- Continue Button -->
                <Button x:Name="ContinueButton"
                        Content="Continue"
                        Click="ContinueButton_Click"
                        IsEnabled="False"
                        Classes="primaryBtn"
                        FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
