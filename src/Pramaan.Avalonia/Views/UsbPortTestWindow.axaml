<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pramaan.Avalonia.ViewModels"
        xmlns:v="using:Pramaan.Avalonia.Views"
        xmlns:conv="using:Pramaan.Avalonia.Converters"
        x:Class="Pramaan.Avalonia.Views.UsbPortTestWindow"
        Title="🔌 USB Port Test" 
        Height="580" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        CanResize="False">
    
    <Window.DataContext>
        <vm:UsbPortTestViewModel />
    </Window.DataContext>

    <Window.Resources>
        <v:UsbVersionColorConverter x:Key="UsbVersionColorConverter"/>
        <v:UsbVersionTextColorConverter x:Key="UsbVersionTextColorConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    
    <Window.Styles>
        <!-- Cancel button -->
        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cancelBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e5e7eb"/>
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        <Style Selector="Button.cancelBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#d1d5db"/>
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        
        <!-- Green button -->
        <Style Selector="Button.greenBtn">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.greenBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A3376"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.greenBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#5C2B5C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Red button -->
        <Style Selector="Button.redBtn">
            <Setter Property="Background" Value="#ef4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.redBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#dc2626"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.redBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#b91c1c"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Small stepper button (+/-) -->
        <Style Selector="Button.stepperBtn">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.stepperBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e5e7eb"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
        <Style Selector="Button.stepperBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#d1d5db"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Styles>
    
    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="16" Padding="20"
            BoxShadow="0 4 6 0 #1A000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="USB Port Test" 
                           FontSize="22" FontWeight="SemiBold" 
                           Foreground="#8B3D88" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Port Count Selector -->
            <Border Grid.Row="1" Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Expected USB Ports" Foreground="#374151" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock Text="Set this to the number of physical USB ports on the laptop" 
                                   Foreground="#6b7280" FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="-" Command="{Binding DecrementPortCountCommand}" 
                                Width="36" Height="36" FontSize="18" FontWeight="Bold" 
                                Classes="stepperBtn"/>
                        <TextBlock Text="{Binding ExpectedPortCount}" 
                                   Foreground="#1f2937" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="16,0"/>
                        <Button Content="+" Command="{Binding IncrementPortCountCommand}"
                                Width="36" Height="36" FontSize="18" FontWeight="Bold" 
                                Classes="stepperBtn"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Progress Bar -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Minimum="0" Maximum="100"
                             Height="8" 
                             Background="#e5e7eb"
                             Foreground="#8B3D88"/>
                <TextBlock Text="{Binding ProgressText}" 
                           Foreground="#6b7280" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <!-- USB Events List -->
            <Border Grid.Row="3" Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Detected Insertions" 
                               Foreground="#8B3D88" FontWeight="SemiBold" FontFamily="Segoe UI"
                               Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InsertionEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Background="#8B3D88" CornerRadius="10" 
                                                    Width="22" Height="22" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding PortNumber}" 
                                                           Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- USB Version Badge -->
                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Background="{Binding UsbVersion, Converter={StaticResource UsbVersionColorConverter}}">
                                                <TextBlock Text="{Binding UsbVersion}" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center" Foreground="{Binding UsbVersion, Converter={StaticResource UsbVersionTextColorConverter}}">
                                                </TextBlock>
                                            </Border>
                                            
                                            <TextBlock Grid.Column="2" Text="{Binding Time}" 
                                                       Foreground="#9ca3af" FontSize="11" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            
                                            <TextBlock Grid.Column="3" Text="{Binding DeviceName}" 
                                                       Foreground="#374151" FontSize="12" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Empty state -->
                    <TextBlock Grid.Row="1" 
                               Text="No USB insertions detected yet.&#x0a;Click 'Start Watching' then plug in a USB device."
                               Foreground="#9ca3af" FontSize="14" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding !InsertionEvents.Count}"/>
                </Grid>
            </Border>
            
            <!-- Instructions -->
            <TextBlock Grid.Row="4" 
                       Text="{Binding Instructions}" 
                       Foreground="#6b7280" FontFamily="Segoe UI"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,12,0,0"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="Cancel" 
                        Command="{Binding CancelTestCommand}"
                        Width="100" Height="40"
                        Margin="0,0,10,0" 
                        Classes="cancelBtn"/>
                
                <!-- Start/Stop Watching Toggle -->
                <Button Content="Start Watching" 
                        Command="{Binding StartWatchingCommand}"
                        IsVisible="{Binding !IsWatching}"
                        Width="150" Height="40" Margin="0,0,10,0" 
                        Classes="greenBtn"/>
                <Button Content="Stop Watching" 
                        Command="{Binding StopWatchingCommand}"
                        IsVisible="{Binding IsWatching}"
                        Width="150" Height="40" Margin="0,0,10,0" 
                        Classes="redBtn"/>
                
                <Button Content="Complete" 
                        Command="{Binding CompleteTestCommand}"
                        Width="120" Height="40" FontWeight="SemiBold"
                        Classes="greenBtn"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
