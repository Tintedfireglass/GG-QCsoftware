<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pramaan.Avalonia.ViewModels"
        xmlns:conv="using:Pramaan.Avalonia.Converters"
        x:Class="Pramaan.Avalonia.Views.KeyboardTestWindow"
        Title="Keyboard Test" 
        Height="660" Width="1180" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        CanResize="True">
    
    <Window.DataContext>
        <vm:KeyboardTestViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <conv:KeyPositionConverter x:Key="KeyPositionConverter"/>
        <conv:KeyWidthConverter x:Key="KeyWidthConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Base key border style -->
        <Style Selector="Border.key_border">
            <Setter Property="Background" Value="#e5e7eb"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
        </Style>
        <!-- Tested key background -->
        <Style Selector="Border.tested">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="BorderBrush" Value="#7A3376"/>
        </Style>
        <Style Selector="TextBlock.key_label">
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        <Style Selector="TextBlock.tested_text">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="FontFamily" Value="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cancelBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e5e7eb"/>
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        <Style Selector="Button.cancelBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#d1d5db"/>
            <Setter Property="Foreground" Value="#6b7280"/>
        </Style>
        
        <!-- Complete button -->
        <Style Selector="Button.completeBtn">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.completeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A3376"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.completeBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#5C2B5C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
    
    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="12" Padding="16"
            BoxShadow="0 4 6 0 #1A000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Numpad checkbox -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Keyboard Test" 
                               FontSize="20" FontWeight="SemiBold" 
                               Foreground="#8B3D88" FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <Border Grid.Column="1" Background="#e5e7eb" CornerRadius="8" Padding="12,6" Margin="8,0,4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Has Numpad" 
                                   VerticalAlignment="Center" 
                                   Foreground="#4b5563" 
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif" 
                                   Margin="0,0,12,0"/>
                        <ToggleSwitch IsChecked="{Binding ShowNumpad}"
                                      Focusable="False"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center"
                                      Margin="0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Progress Bar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Minimum="0" Maximum="100"
                             Height="8" 
                             Background="#e5e7eb"
                             Foreground="#8B3D88"/>
                <TextBlock Text="{Binding ProgressText}" 
                           Foreground="#6b7280" 
                           FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>
            
            <!-- Keyboard Layout - with clipping -->
            <Border Grid.Row="2" Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" 
                    Padding="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Keys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Height="280" Width="1020"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter">
                                <Setter Property="Canvas.Left">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource KeyPositionConverter}" ConverterParameter="X">
                                            <Binding Path="Column"/>
                                            <Binding Path="Width"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Canvas.Top">
                                    <Setter.Value>
                                        <Binding Path="Row" Converter="{StaticResource KeyPositionConverter}" ConverterParameter="Y"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Margin="1" 
                                        MinHeight="36"
                                        Classes="key_border"
                                        BorderThickness="1"
                                        Classes.tested="{Binding IsTested}"
                                        Width="{Binding Width, Converter={StaticResource KeyWidthConverter}}">
                                     <TextBlock Text="{Binding Label}" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Classes="key_label"
                                                Classes.tested_text="{Binding IsTested}"
                                                FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif">
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            
            <!-- Instructions -->
            <TextBlock Grid.Row="3" 
                       Text="{Binding Instructions}" 
                       Foreground="#6b7280" 
                       FontFamily="Segoe UI, SF Pro Display, Helvetica Neue, Arial, sans-serif"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Cancel" 
                        Command="{Binding CancelTestCommand}"
                        Width="120" Height="38"
                        Margin="0,0,16,0"
                        Classes="cancelBtn"/>
                
                <Button Content="Complete Test" 
                        Command="{Binding CompleteTestCommand}"
                        Width="150" Height="38"
                        Classes="completeBtn"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
