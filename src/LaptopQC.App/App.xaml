<Application x:Class="LaptopQC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Bool to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Inverse Bool Converter -->
        <local:InverseBoolConverter x:Key="InverseBoolConverter" 
                                     xmlns:local="clr-namespace:LaptopQC.App.Converters"/>

        <!-- Inverse Bool to Visibility Converter -->
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" 
                                     xmlns:local="clr-namespace:LaptopQC.App.Converters"/>

        <!-- Empty collection/count to Visibility Converter -->
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"
                                     xmlns:local="clr-namespace:LaptopQC.App.Converters"/>
        
        <!-- Bool to Pass/Fail Converter -->
        <local:BoolToPassFailConverter x:Key="BoolToPassFailConverter" 
                                        xmlns:local="clr-namespace:LaptopQC.App.Converters"/>
        
        <!-- Bool to Color Converter -->
        <local:BoolToColorConverter x:Key="BoolToColorConverter" 
                                     xmlns:local="clr-namespace:LaptopQC.App.Converters"/>
        
        <!-- Grade to Color Converter -->
        <local:GradeToColorConverter x:Key="GradeToColorConverter" 
                                     xmlns:local="clr-namespace:LaptopQC.App.Converters"/>
        
        <!-- Keyboard Position Converter -->
        <local:KeyPositionConverter x:Key="KeyPositionConverter" 
                                     xmlns:local="clr-namespace:LaptopQC.App.Converters"/>
        
        <!-- Keyboard Width Converter -->
        <local:KeyWidthConverter x:Key="KeyWidthConverter" 
                                  xmlns:local="clr-namespace:LaptopQC.App.Converters"/>
        
        <!-- Equality Converter (string comparison for radio button groups) -->
        <local:EqualityConverter x:Key="EqualityConverter" 
                                  xmlns:local="clr-namespace:LaptopQC.App.Converters"/>
        
        <!-- Card Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          ShadowDepth="4" 
                          BlurRadius="12" 
                          Opacity="0.15"/>
    </Application.Resources>
</Application>
