<Window x:Class="LaptopQC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="Laptop QC Tool" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Dark theme styles -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e94560"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#16213e"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a0a0a0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ff6b6b"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔧 Laptop QC Tool" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Refurbished Laptop Diagnostic System" 
                       Foreground="#a0a0a0" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- System Info Card -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Information" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer:" Style="{StaticResource InfoText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SystemInfo.ComputerName, FallbackValue='-'}" Style="{StaticResource ValueText}"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model:" Style="{StaticResource InfoText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SystemInfo.Model, FallbackValue='-'}" Style="{StaticResource ValueText}"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial:" Style="{StaticResource InfoText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SystemInfo.SerialNumber, FallbackValue='-'}" Style="{StaticResource ValueText}"/>
                    </Grid>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="▶ Run Diagnostics" 
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunDiagnosticsCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"/>
            </Grid>
        </Border>
        
        <!-- Results Grid -->
        <Grid Grid.Row="2" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- CPU Card -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="💻 CPU" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Processor" Style="{StaticResource InfoText}"/>
                    <TextBlock Text="{Binding CpuInfo.Name, FallbackValue='-'}" Style="{StaticResource ValueText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,5">
                            <TextBlock Text="Cores" Style="{StaticResource InfoText}"/>
                            <TextBlock Text="{Binding CpuInfo.Cores, FallbackValue='-'}" Style="{StaticResource ValueText}" FontSize="20"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,5">
                            <TextBlock Text="Threads" Style="{StaticResource InfoText}"/>
                            <TextBlock Text="{Binding CpuInfo.Threads, FallbackValue='-'}" Style="{StaticResource ValueText}" FontSize="20"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5">
                            <TextBlock Text="Max Clock" Style="{StaticResource InfoText}"/>
                            <TextBlock Style="{StaticResource ValueText}" FontSize="16">
                                <Run Text="{Binding CpuInfo.MaxClockSpeedMHz, FallbackValue='-'}"/>
                                <Run Text=" MHz"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5">
                            <TextBlock Text="Architecture" Style="{StaticResource InfoText}"/>
                            <TextBlock Text="{Binding CpuInfo.Architecture, FallbackValue='-'}" Style="{StaticResource ValueText}" FontSize="16"/>
                        </StackPanel>
                    </Grid>
                    
                    <Border Background="#0f3460" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <TextBlock Text="{Binding CpuStatus, FallbackValue='Not scanned'}" Foreground="#00d9ff" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- RAM Card -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="🧠 Memory" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,15"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding RamInfo.TotalCapacityGB, FallbackValue='-'}" 
                                   Foreground="#ffffff" FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text=" GB" Foreground="#a0a0a0" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </StackPanel>
                    
                    <TextBlock Style="{StaticResource InfoText}" Margin="0,0,0,10">
                        <Run Text="{Binding RamInfo.UsedSlots, FallbackValue='-'}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding RamInfo.TotalSlots, FallbackValue='-'}"/>
                        <Run Text=" slots used"/>
                    </TextBlock>
                    
                    <ItemsControl ItemsSource="{Binding RamInfo.Modules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0f3460" CornerRadius="4" Padding="8" Margin="0,2">
                                    <TextBlock Foreground="#ffffff" FontSize="12">
                                        <Run Text="Slot "/>
                                        <Run Text="{Binding Slot}"/>
                                        <Run Text=": "/>
                                        <Run Text="{Binding CapacityGB}"/>
                                        <Run Text="GB "/>
                                        <Run Text="{Binding MemoryType}"/>
                                        <Run Text=" @ "/>
                                        <Run Text="{Binding SpeedMHz}"/>
                                        <Run Text="MHz"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <Border Background="#0f3460" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <TextBlock Text="{Binding RamStatus, FallbackValue='Not scanned'}" Foreground="#00d9ff" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#0f3460" CornerRadius="8" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#00d9ff" VerticalAlignment="Center"/>
                <ProgressBar IsIndeterminate="{Binding IsScanning}" 
                             Height="3" 
                             Background="Transparent"
                             Foreground="#e94560"
                             VerticalAlignment="Bottom"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
