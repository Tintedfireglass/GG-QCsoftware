<Window x:Class="LaptopQC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="Laptop QC Tool" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Dark theme styles -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e94560"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#16213e"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a0a0a0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ff6b6b"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🔧 Laptop QC Tool" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Refurbished Laptop Diagnostic System" 
                       Foreground="#a0a0a0" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- System Info Card -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Information" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer:" Style="{StaticResource InfoText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SystemInfo.ComputerName, FallbackValue='-'}" Style="{StaticResource ValueText}"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model:" Style="{StaticResource InfoText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SystemInfo.Model, FallbackValue='-'}" Style="{StaticResource ValueText}"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial:" Style="{StaticResource InfoText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SystemInfo.SerialNumber, FallbackValue='-'}" Style="{StaticResource ValueText}"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="MAC:" Style="{StaticResource InfoText}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SystemInfo.MacAddress, FallbackValue='-'}" Style="{StaticResource ValueText}"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚡ Stress Test" 
                            Command="{Binding RunStressTestsCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Background" Value="#e0a800"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#ffc107"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="▶ Run Diagnostics" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunDiagnosticsCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Results Grid -->
        <Grid Grid.Row="2" Margin="0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- CPU and RAM Cards Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="💻 CPU" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Processor" Style="{StaticResource InfoText}"/>
                        <TextBlock Text="{Binding CpuInfo.Name, FallbackValue='-'}" Style="{StaticResource ValueText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cores / Threads" Style="{StaticResource InfoText}"/>
                                <TextBlock Style="{StaticResource ValueText}" FontSize="18">
                                    <Run Text="{Binding CpuInfo.Cores, FallbackValue='-'}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding CpuInfo.Threads, FallbackValue='-'}"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Base Clock" Style="{StaticResource InfoText}"/>
                                <TextBlock Style="{StaticResource ValueText}" FontSize="18">
                                    <Run Text="{Binding CpuInfo.MaxClockSpeedMHz, FallbackValue='-'}"/>
                                    <Run Text=" MHz"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        
                        <Border Background="#0f3460" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding CpuStatus, FallbackValue='Not scanned'}" Foreground="#00d9ff" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- RAM Card -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="🧠 Memory" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding RamInfo.TotalCapacityGB, FallbackValue='-'}" 
                                       Foreground="#ffffff" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text=" GB" Foreground="#a0a0a0" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                        
                        <TextBlock Style="{StaticResource InfoText}" Margin="0,0,0,5">
                            <Run Text="{Binding RamInfo.UsedSlots, FallbackValue='-'}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding RamInfo.TotalSlots, FallbackValue='-'}"/>
                            <Run Text=" slots"/>
                        </TextBlock>
                        
                        <Border Background="#0f3460" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding RamStatus, FallbackValue='Not scanned'}" Foreground="#00d9ff" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Storage and Battery Cards Row -->
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Storage Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="💾 Storage" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                            
                            <!-- SMART Test Button -->
                            <Button Grid.Column="1" Content="🔍 SMART Test" 
                                    Command="{Binding RunSmartTestCommand}"
                                    IsEnabled="{Binding IsSmartTestRunning, Converter={StaticResource InverseBoolConverter}}"
                                    ToolTip="Run SMART self-test on all drives (~2 min per drive)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#2d5a27"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3d7a37"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#555555"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding StorageInfo.TotalCapacityGB, FallbackValue='-', StringFormat='{}{0:F0}'}" 
                                       Foreground="#ffffff" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text=" GB" Foreground="#a0a0a0" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding StorageInfo.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0f3460" CornerRadius="4" Padding="8" Margin="0,2">
                                        <StackPanel>
                                            <TextBlock Foreground="#ffffff" FontSize="11" TextWrapping="Wrap" Text="{Binding Model}"/>
                                            <TextBlock Foreground="#a0a0a0" FontSize="10">
                                                <Run Text="{Binding SizeGB, StringFormat='{}{0:F0} GB'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- SMART Test Progress -->
                        <StackPanel Visibility="{Binding IsSmartTestRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Value="{Binding SmartTestProgress}" 
                                         Minimum="0" Maximum="100"
                                         Height="4" 
                                         Background="#0f3460"
                                         Foreground="#2d5a27"
                                         Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SmartTestStatus}" Foreground="#a0a0a0" FontSize="10"/>
                        </StackPanel>
                        
                        <Border Background="#0f3460" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding StorageStatus, FallbackValue='Not scanned'}" Foreground="#00d9ff" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Battery Card -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="🔋 Battery" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Charge" Style="{StaticResource InfoText}"/>
                                <TextBlock Style="{StaticResource ValueText}" FontSize="24">
                                    <Run Text="{Binding BatteryInfo.EstimatedChargeRemaining, FallbackValue='-'}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Health" Style="{StaticResource InfoText}"/>
                                <TextBlock Style="{StaticResource ValueText}" FontSize="24">
                                    <Run Text="{Binding BatteryInfo.HealthPercent, FallbackValue='-'}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Style="{StaticResource InfoText}" Margin="0,8,0,0">
                            <Run Text="Wear: "/>
                            <Run Text="{Binding BatteryInfo.WearLevelPercent, FallbackValue='-'}"/>
                            <Run Text="% • Cycles: "/>
                            <Run Text="{Binding BatteryInfo.CycleCount, FallbackValue='-'}"/>
                        </TextBlock>
                        
                        <Border Background="#0f3460" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding BatteryStatus, FallbackValue='Not scanned'}" Foreground="#00d9ff" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Devices Card (Keyboard, USB, Webcam, etc.) -->
            <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="5,5,5,0">
                <StackPanel>
                    <TextBlock Text="🔌 Devices" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Input Devices -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Input Devices" Style="{StaticResource InfoText}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="⌨️" FontSize="14"/>
                                <TextBlock Text="{Binding DevicesInfo.HasKeyboard, Mode=OneWay, Converter={StaticResource BoolToPassFailConverter}, FallbackValue='?'}" 
                                           Foreground="{Binding DevicesInfo.HasKeyboard, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}" Margin="5,0"/>
                                <TextBlock Text="Keyboard" Style="{StaticResource ValueText}"/>
                                <Button Content="🧪 Test" 
                                        Command="{Binding OpenKeyboardTestCommand}"
                                        Margin="10,0,0,0"
                                        ToolTip="Test all keyboard keys">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2d5a27"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3d7a37"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🖱️" FontSize="14"/>
                                <TextBlock Text="{Binding DevicesInfo.HasTrackpad, Mode=OneWay, Converter={StaticResource BoolToPassFailConverter}, FallbackValue='?'}" 
                                           Foreground="{Binding DevicesInfo.HasTrackpad, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}" Margin="5,0"/>
                                <TextBlock Text="Trackpad" Style="{StaticResource ValueText}"/>
                                <Button Content="🧪 Test" 
                                        Command="{Binding OpenTrackpadTestCommand}"
                                        Margin="10,0,0,0"
                                        ToolTip="Test trackpad movement, clicks, and scroll">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2d5a27"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3d7a37"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- USB Ports -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="USB Ports" Style="{StaticResource InfoText}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DevicesInfo.TotalUsbPorts, Mode=OneWay, FallbackValue='0'}" 
                                           Foreground="#ffffff" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text=" total" Foreground="#a0a0a0" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                <Button Content="🧪 Test" 
                                        Command="{Binding OpenUsbPortTestCommand}"
                                        Margin="15,0,0,0"
                                        ToolTip="Test each USB port by plugging in a device">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2d5a27"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3d7a37"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource InfoText}" Text="{Binding DevicesInfo.Usb3Ports, Mode=OneWay, FallbackValue='0'}"/>
                                <TextBlock Style="{StaticResource InfoText}" Text=" USB 3.x • "/>
                                <TextBlock Style="{StaticResource InfoText}" Text="{Binding DevicesInfo.Usb2Ports, Mode=OneWay, FallbackValue='0'}"/>
                                <TextBlock Style="{StaticResource InfoText}" Text=" USB 2.0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Camera and Displays -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Camera/Display" Style="{StaticResource InfoText}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="📷" FontSize="14"/>
                                <TextBlock Text="{Binding DevicesInfo.HasWebcam, Mode=OneWay, Converter={StaticResource BoolToPassFailConverter}, FallbackValue='?'}" 
                                           Foreground="{Binding DevicesInfo.HasWebcam, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}" Margin="5,0"/>
                                <TextBlock Text="Webcam" Style="{StaticResource ValueText}"/>
                                <Button Content="🔊 Test A/V" 
                                        Command="{Binding OpenAudioVideoTestCommand}"
                                        Margin="10,0,0,0"
                                        ToolTip="Test Speakers, Microphone, and Camera">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2d5a27"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3d7a37"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🖥️" FontSize="14"/>
                                <TextBlock Style="{StaticResource ValueText}" Margin="5,0">
                                    <Run Text="{Binding DevicesInfo.Displays.Count, Mode=OneWay, FallbackValue='0'}"/>
                                    <Run Text=" Display(s)"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <Border Background="#0f3460" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding DevicesStatus, FallbackValue='Not scanned'}" Foreground="#00d9ff" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Test Results List -->
            <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="5,10,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="📋 Test Results" FontSize="16" FontWeight="SemiBold" Foreground="#e94560" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0f3460" CornerRadius="6" Padding="12,8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding Component}" Foreground="#e94560" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Test}" Foreground="#a0a0a0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#ffffff" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#ff6b6b"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Foreground" Value="#00d9ff"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                </Grid>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#0f3460" CornerRadius="8" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#00d9ff" VerticalAlignment="Center"/>
                <ProgressBar IsIndeterminate="{Binding IsScanning}" 
                             Height="3" 
                             Background="Transparent"
                             Foreground="#e94560"
                             VerticalAlignment="Bottom"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
