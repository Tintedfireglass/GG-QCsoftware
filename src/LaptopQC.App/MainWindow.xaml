<Window x:Class="LaptopQC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="PRAMAAN" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Light theme with green accent styles -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B3D88"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B3D88"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1f2937"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <Style x:Key="LargeValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1f2937"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <!-- Primary Green Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A3376"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#d1d5db"/>
                    <Setter Property="Foreground" Value="#9ca3af"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Outline Button (for Stress Test style) -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ef4444"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#8B3D88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fef2f2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="#d1d5db"/>
                    <Setter Property="Foreground" Value="#9ca3af"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Small Test Button -->
        <Style x:Key="SmallTestButton" TargetType="Button">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A3376"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#d1d5db"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Card Panel -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        
        <!-- Status Box - Success -->
        <Style x:Key="StatusBoxSuccess" TargetType="Border">
            <Setter Property="Background" Value="#dcfce7"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        
        <!-- Status Box - Info -->
        <Style x:Key="StatusBoxInfo" TargetType="Border">
            <Setter Property="Background" Value="#f0f9ff"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        
        <!-- Device Item Box -->
        <Style x:Key="DeviceItemBox" TargetType="Border">
            <Setter Property="Background" Value="#f9fafb"/>
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Logo Icon -->
            <!-- Logo Icon -->
            <Image Grid.Column="0" Source="/Resources/pramana_logo.png" Width="50" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PRAMAAN" FontSize="20" FontWeight="Bold" Foreground="#1f2937" FontFamily="Segoe UI"/>
                <TextBlock Text="the device health &amp; lifecycle intelligence layer for refurbished electronics." 
                           Foreground="#6b7280" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>
            
            <!-- User Status / Login -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="UserStatusBorder" 
                        Background="#f3f4f6" 
                        BorderBrush="#e5e7eb"
                        BorderThickness="1"
                        CornerRadius="6" 
                        Padding="12,8"
                        MouseLeftButtonDown="UserStatus_Click"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UserStatusIcon" Text="🔑" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UserStatusText" 
                                   Text="Click to Activate" 
                                   Foreground="#6b7280" 
                                   FontSize="12" 
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" 
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        
        <!-- System Info Card -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Information" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer :" Style="{StaticResource InfoLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SystemInfo.ComputerName, FallbackValue='-'}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model :" Style="{StaticResource InfoLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemInfo.Model, FallbackValue='-'}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial :" Style="{StaticResource InfoLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemInfo.SerialNumber, FallbackValue='-'}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Mac :" Style="{StaticResource InfoLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SystemInfo.MacAddress, FallbackValue='-'}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Full QC - Outline style with cyan text -->
                    <Button Content="Full QC" 
                            Command="{Binding StartFullQcCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Setter Property="Foreground" Value="#0891b2"/>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Run Diagnostics - Outline style with green text -->
                    <Button Content="Basic QC" 
                            Command="{Binding RunDiagnosticsCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Setter Property="Foreground" Value="#8B3D88"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Results Grid -->
        <Grid Grid.Row="2" Margin="0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- CPU and Memory Cards Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="💻" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="CPU" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Processor" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding CpuInfo.Name, FallbackValue='-'}" Style="{StaticResource ValueText}" TextWrapping="Wrap" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Graphics card" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding GpuInfo.Name, FallbackValue='-'}" Style="{StaticResource ValueText}" TextWrapping="Wrap" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cores/Threads" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Style="{StaticResource LargeValue}">
                                    <Run Text="{Binding CpuInfo.Cores, FallbackValue='-'}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding CpuInfo.Threads, FallbackValue='-'}"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Base Clock" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Style="{StaticResource LargeValue}">
                                    <Run Text="{Binding CpuInfo.MaxClockSpeedMHz, FallbackValue='-'}"/>
                                    <Run Text=" MHz" FontSize="14" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        
                        <Border Style="{StaticResource StatusBoxSuccess}">
                            <TextBlock Text="{Binding CpuStatus, FallbackValue='Not scanned'}" Foreground="#15803d" FontSize="12" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Memory Card -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🧠" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Memory" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        
                        <StackPanel>
                            <TextBlock Text="RAM" Style="{StaticResource InfoLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RamInfo.TotalCapacityGB, FallbackValue='-'}" Style="{StaticResource LargeValue}"/>
                                <TextBlock Text=" GB" Foreground="#6b7280" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Slots" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Style="{StaticResource ValueText}">
                                <Run Text="{Binding RamInfo.UsedSlots, FallbackValue='-'}"/>
                                <Run Text=" of "/>
                                <Run Text="{Binding RamInfo.TotalSlots, FallbackValue='-'}"/>
                                <Run Text=" slots"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <Border Style="{StaticResource StatusBoxSuccess}">
                            <TextBlock Text="{Binding RamStatus, FallbackValue='Not scanned'}" Foreground="#15803d" FontSize="12" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Storage and Battery Cards Row -->
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Storage Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Storage" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Total" Style="{StaticResource InfoLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StorageInfo.TotalCapacityGB, FallbackValue='-', StringFormat='{}{0:F0}'}" Style="{StaticResource LargeValue}"/>
                                <TextBlock Text=" GB" Foreground="#6b7280" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding StorageInfo.Devices}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DeviceItemBox}">
                                        <StackPanel>
                                            <TextBlock Foreground="#1f2937" FontSize="12" TextWrapping="Wrap" Text="{Binding Model}" FontFamily="Segoe UI"/>
                                            <TextBlock Foreground="#6b7280" FontSize="11" FontFamily="Segoe UI">
                                                <Run Text="{Binding SizeGB, StringFormat='{}{0:F0} GB'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- SMART Test Progress -->
                        <StackPanel Visibility="{Binding IsSmartTestRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Value="{Binding SmartTestProgress}" 
                                         Minimum="0" Maximum="100"
                                         Height="4" 
                                         Background="#e5e7eb"
                                         Foreground="#8B3D88"
                                         Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SmartTestStatus}" Foreground="#6b7280" FontSize="10"/>
                        </StackPanel>
                        
                        <Border Style="{StaticResource StatusBoxSuccess}">
                            <TextBlock Text="{Binding StorageStatus, FallbackValue='Not scanned'}" Foreground="#15803d" FontSize="12" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Battery Card (labeled as Storage in mockup but showing battery data) -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔋" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Battery" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Charge" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Foreground="#8B3D88" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI">
                                    <Run Text="{Binding BatteryInfo.EstimatedChargeRemaining, FallbackValue='-'}"/>
                                    <Run Text=" %" FontSize="16"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Health" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Style="{StaticResource LargeValue}">
                                    <Run Text="{Binding BatteryInfo.HealthPercent, FallbackValue='-'}"/>
                                    <Run Text=" %" FontSize="16" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        
                        <Border Style="{StaticResource DeviceItemBox}" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}">
                                <Run Text="Wear: "/>
                                <Run Text="{Binding BatteryInfo.WearLevelPercent, FallbackValue='-'}" Foreground="#8B3D88"/>
                                <Run Text="%  |  Cycles: "/>
                                <Run Text="{Binding BatteryInfo.CycleCount, FallbackValue='-'}" Foreground="#8B3D88"/>
                            </TextBlock>
                        </Border>
                        
                        <Border Style="{StaticResource StatusBoxSuccess}">
                            <TextBlock Text="{Binding BatteryStatus, FallbackValue='Not scanned'}" Foreground="#15803d" FontSize="12" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Devices + Security Row -->
            <Grid Grid.Row="2" Margin="5,0,5,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Devices Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🔌" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Devices" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Row 1: Input Devices -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Input Devices" Style="{StaticResource InfoLabel}" Margin="0,0,0,6"/>
                                
                                <!-- Keyboard -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="Keyboard" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                    <Button Content="Test" 
                                            Command="{Binding OpenKeyboardTestCommand}"
                                            Style="{StaticResource SmallTestButton}"
                                            Margin="10,0,0,0"
                                            ToolTip="Test all keyboard keys"/>
                                </StackPanel>
                                
                                <!-- Trackpad -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="Trackpad" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                    <Button Content="Test" 
                                            Command="{Binding OpenTrackpadTestCommand}"
                                            Style="{StaticResource SmallTestButton}"
                                            Margin="10,0,0,0"
                                            ToolTip="Test trackpad movement, clicks, and scroll"/>
                                </StackPanel>
                                
                            </Grid>
                            
                            <!-- Camera / Display Row -->
                            <TextBlock Text="Camera" Style="{StaticResource InfoLabel}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="Webcam" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                    <Button Content="Test A/V" 
                                            Command="{Binding OpenAudioVideoTestCommand}"
                                            Style="{StaticResource SmallTestButton}"
                                            Margin="10,0,0,0"
                                            ToolTip="Test Speakers, Microphone, and Camera"/>
                                </StackPanel>
                                
                            </Grid>
                            
                            <!-- USB Controllers -->
                            <TextBlock Text="USB  Controllers" Style="{StaticResource InfoLabel}" Margin="0,12,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DevicesInfo.TotalUsbPorts, Mode=OneWay, FallbackValue='0'}" Style="{StaticResource LargeValue}"/>
                                <TextBlock Text=" Total" Foreground="#6b7280" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                <Button Content="Test" 
                                        Command="{Binding OpenUsbPortTestCommand}"
                                        Style="{StaticResource SmallTestButton}"
                                        Margin="15,0,0,0"
                                        ToolTip="Test each USB port by plugging in a device"/>
                                <TextBlock Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <Run Text="{Binding DevicesInfo.Usb3Ports, Mode=OneWay, FallbackValue='0'}"/>
                                    <Run Text=" USB 3.x .. "/>
                                    <Run Text="{Binding DevicesInfo.Usb2Ports, Mode=OneWay, FallbackValue='0'}"/>
                                    <Run Text=" USB 2.0"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <Border Style="{StaticResource StatusBoxSuccess}" Margin="0,12,0,0">
                                <TextBlock Text="{Binding DevicesStatus, FallbackValue='Not scanned'}" Foreground="#15803d" FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                        
                    </Grid>
                </Border>

                <!-- Security Card -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Security" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshSecurityCommand}"
                                    IsEnabled="{Binding IsSecurityChecking, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                                    Style="{StaticResource SmallTestButton}"
                                    Padding="10,6"
                                    ToolTip="Refresh Windows activation and antivirus status"/>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="Windows Activation" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding WindowsActivationStatus, FallbackValue='Not scanned'}" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Antivirus" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding AntivirusStatus, FallbackValue='Not scanned'}" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Style="{StaticResource StatusBoxSuccess}" Margin="0,12,0,0">
                            <TextBlock Text="Security checks reflect Windows license and antivirus status only."
                                       Foreground="#15803d" FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Test Results List -->
            <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="5,5,5,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Test Results" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#e5e7eb" BorderThickness="0,0,0,1" Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding Component}" Foreground="#8B3D88" FontWeight="Medium" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Test}" Foreground="#6b7280" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#1f2937" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                            
                                            <!-- Pass/Fail Badge -->
                                            <Border Grid.Column="3" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#fee2e2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Background" Value="#dcfce7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontWeight="Medium" FontSize="11" FontFamily="Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#dc2626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                    <Setter Property="Foreground" Value="#15803d"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                </Grid>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#f3f4f6" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="5,10,5,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#6b7280" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                <ProgressBar IsIndeterminate="{Binding IsScanning}" 
                             Height="3" 
                             Background="Transparent"
                             Foreground="#8B3D88"
                             VerticalAlignment="Bottom"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
