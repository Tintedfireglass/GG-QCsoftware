<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Strings -->
  <sys:String x:Key="AppDisplayName">PRAMAAN</sys:String>

  <!-- Typography -->
  <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

  <!-- Colors -->
  <Color x:Key="BrandPrimaryColor">#FF8B3D88</Color>
  <Color x:Key="BrandPrimaryHoverColor">#FF7A3376</Color>
  <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
  <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />

  <!-- Palette -->
  <Color x:Key="TextPrimaryColor">#FF1F2937</Color>
  <Color x:Key="TextSecondaryColor">#FF6B7280</Color>
  <Color x:Key="BorderGreyColor">#FFE5E7EB</Color>
  <Color x:Key="BorderGreyDarkColor">#FFD1D5DB</Color>
  <Color x:Key="DisabledTextColor">#FF9CA3AF</Color>
  <Color x:Key="SuccessYesColor">#FF15803D</Color>
  <Color x:Key="DangerNoColor">#FFDC2626</Color>
  <Color x:Key="UsbBlueColor">#FF2595FF</Color>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="BorderGreyBrush" Color="{StaticResource BorderGreyColor}" />
  <SolidColorBrush x:Key="BorderGreyDarkBrush" Color="{StaticResource BorderGreyDarkColor}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
  <SolidColorBrush x:Key="SuccessYesBrush" Color="{StaticResource SuccessYesColor}" />
  <SolidColorBrush x:Key="DangerNoBrush" Color="{StaticResource DangerNoColor}" />
	  <SolidColorBrush x:Key="UsbBlueBrush" Color="{StaticResource UsbBlueColor}" />

	  <!-- Surfaces -->
	  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="White" />
	  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF9FAFB" />
	  <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#FFF3F4F6" />

  <!-- Semantic aliases (from whitelabel spec) -->
  <SolidColorBrush x:Key="Black1Brush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="Black2Brush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="BorderGreySpecBrush" Color="{StaticResource BorderGreyColor}" />
  <SolidColorBrush x:Key="ProcessingBrush" Color="{StaticResource BrandPrimaryColor}" />
</ResourceDictionary>
