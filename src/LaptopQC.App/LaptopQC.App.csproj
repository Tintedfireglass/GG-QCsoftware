<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Brand Condition="'$(Brand)' == ''">Pramaan</Brand>
  </PropertyGroup>

  <Import Project="Branding\$(Brand).props" Condition="Exists('Branding\$(Brand).props')" />

  <PropertyGroup>
    <BrandAppDisplayName Condition="'$(BrandAppDisplayName)' == ''">PRAMAAN</BrandAppDisplayName>
    <BrandExeName Condition="'$(BrandExeName)' == ''">Pramaan</BrandExeName>
    <BrandProductName Condition="'$(BrandProductName)' == ''">PRAMAAN</BrandProductName>
    <BrandCompanyName Condition="'$(BrandCompanyName)' == ''">Gadget Guruz</BrandCompanyName>
    <BrandPublisherName Condition="'$(BrandPublisherName)' == ''">GadgetGuruz</BrandPublisherName>
    <BrandUpdateUrl Condition="'$(BrandUpdateUrl)' == ''">https://pramaan-dashboard.gadgetguruz.com</BrandUpdateUrl>
    <BrandIconPath Condition="'$(BrandIconPath)' == ''">Resources\pramana_icon.ico</BrandIconPath>
    <BrandXamlKey Condition="'$(BrandXamlKey)' == ''">Pramaan</BrandXamlKey>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaptopQC.Core\LaptopQC.Core.csproj" />
    <ProjectReference Include="..\LaptopQC.Hardware\LaptopQC.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="System.Management" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>$(BrandIconPath)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\pramana_logo.png" Condition="Exists('Resources\pramana_logo.png')" />
    <Resource Include="$(BrandIconPath)" Condition="Exists('$(BrandIconPath)')" />
    <Content Include="$(BrandIconPath)" Condition="Exists('$(BrandIconPath)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\scripts\legal.txt">
      <Link>legal.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
	  <PropertyGroup>
	    <!-- App Info -->
	    <AssemblyName>$(BrandExeName)</AssemblyName>
	    <Product>$(BrandProductName)</Product>
	    <Company>$(BrandCompanyName)</Company>
	    <Version>1.0.8</Version>
	    
	  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Brand" Value="$(BrandXamlKey)" />
    <AssemblyMetadata Include="Brand.AppDisplayName" Value="$(BrandAppDisplayName)" />
    <AssemblyMetadata Include="Brand.Publisher" Value="$(BrandPublisherName)" />
    <AssemblyMetadata Include="Brand.UpdateUrl" Value="$(BrandUpdateUrl)" />
    <AssemblyMetadata Include="Brand.IconFileName" Value="$([System.IO.Path]::GetFileName('$(BrandIconPath)'))" />
  </ItemGroup>

  <!-- SMART NVMe self-tests require admin rights (IOCTL_STORAGE_PROTOCOL_COMMAND). -->
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Single-file publishing (only for publish) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Bundle smartctl.exe for SMART testing -->
  <ItemGroup>
    <None Include="tools\smartctl.exe" Condition="Exists('tools\smartctl.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\smartctl.exe</Link>
    </None>
    <None Include="tools\*.dll" Condition="Exists('tools\smartctl.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>


  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>
</Project>



