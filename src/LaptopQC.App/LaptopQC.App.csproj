<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LaptopQC.Core\LaptopQC.Core.csproj" />
    <ProjectReference Include="..\LaptopQC.Hardware\LaptopQC.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- App Info -->
    <AssemblyName>LaptopQC</AssemblyName>
    <Product>Laptop QC Tool</Product>
    <Company>GG Internship</Company>
    <Version>1.0.0</Version>
    
    <!-- Require admin privileges -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Single-file publishing (only for publish) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Bundle smartctl.exe for SMART testing -->
  <ItemGroup>
    <None Include="tools\smartctl.exe" Condition="Exists('tools\smartctl.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\smartctl.exe</Link>
    </None>
    <None Include="tools\*.dll" Condition="Exists('tools\smartctl.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>

