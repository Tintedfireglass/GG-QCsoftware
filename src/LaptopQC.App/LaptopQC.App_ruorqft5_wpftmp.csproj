<Project>
  <PropertyGroup>
    <AssemblyName>Pramaan</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\gento\Desktop\Projects\GG Internship\QC tool\src\LaptopQC.App\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>LaptopQC.App</_TargetAssemblyProjectName>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <ProjectReference Include="..\LaptopQC.Core\LaptopQC.Core.csproj" />
    <ProjectReference Include="..\LaptopQC.Hardware\LaptopQC.Hardware.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\pramana_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\scripts\legal.txt">
      <Link>legal.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup>
    <!-- App Info -->
    <AssemblyName>Pramaan</AssemblyName>
    <Product>PRAMAAN</Product>
    <Company>Gadget Guruz</Company>
    <Version>1.0.4</Version>
  </PropertyGroup>
  <!-- SMART NVMe self-tests require admin rights (IOCTL_STORAGE_PROTOCOL_COMMAND). -->
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Single-file publishing (only for publish) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <!-- Bundle smartctl.exe for SMART testing -->
  <ItemGroup>
    <None Include="tools\smartctl.exe" Condition="Exists('tools\smartctl.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\smartctl.exe</Link>
    </None>
    <None Include="tools\*.dll" Condition="Exists('tools\smartctl.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>
