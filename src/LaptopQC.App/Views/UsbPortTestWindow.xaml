<Window x:Class="LaptopQC.App.Views.UsbPortTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="🔌 USB Port Test" 
        Height="580" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:UsbPortTestViewModel />
    </Window.DataContext>
    
    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="16" Padding="20"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🔌" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="USB Port Test" 
                           FontSize="22" FontWeight="SemiBold" 
                           Foreground="#8B3D88" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Port Count Selector -->
            <Border Grid.Row="1" Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Expected USB Ports" Foreground="#374151" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock Text="Set this to the number of physical USB ports on the laptop" 
                                   Foreground="#6b7280" FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="-" Command="{Binding DecrementPortCountCommand}" 
                                Width="36" Height="36" FontSize="18" FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#f3f4f6"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="BorderBrush" Value="#d1d5db"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#e5e7eb"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding ExpectedPortCount}" 
                                   Foreground="#1f2937" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="16,0"/>
                        <Button Content="+" Command="{Binding IncrementPortCountCommand}"
                                Width="36" Height="36" FontSize="18" FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#f3f4f6"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="BorderBrush" Value="#d1d5db"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#e5e7eb"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Progress Bar -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Minimum="0" Maximum="100"
                             Height="8" 
                             Background="#e5e7eb"
                             Foreground="#8B3D88"/>
                <TextBlock Text="{Binding ProgressText}" 
                           Foreground="#6b7280" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <!-- USB Events List -->
            <Border Grid.Row="3" Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Detected Insertions" 
                               Foreground="#8B3D88" FontWeight="SemiBold" FontFamily="Segoe UI"
                               Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InsertionEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Background="#8B3D88" CornerRadius="10" 
                                                    Width="22" Height="22" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding PortNumber}" 
                                                           Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- USB Version Badge -->
                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#e5e7eb"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsbVersion}" Value="USB 3.x">
                                                                <Setter Property="Background" Value="#0891b2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding UsbVersion}" Value="USB 2.0">
                                                                <Setter Property="Background" Value="#6b7280"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding UsbVersion}" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#374151"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UsbVersion}" Value="USB 3.x">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UsbVersion}" Value="USB 2.0">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            
                                            <TextBlock Grid.Column="2" Text="{Binding Time}" 
                                                       Foreground="#9ca3af" FontSize="11" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            
                                            <TextBlock Grid.Column="3" Text="{Binding DeviceName}" 
                                                       Foreground="#374151" FontSize="12" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Empty state -->
                    <TextBlock Grid.Row="1" 
                               Text="No USB insertions detected yet.&#x0a;Click 'Start Watching' then plug in a USB device."
                               Foreground="#9ca3af" FontSize="14" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding InsertionEvents.Count, Converter={StaticResource InverseBoolToVisConverter}, FallbackValue=Visible}"/>
                </Grid>
            </Border>
            
            <!-- Instructions -->
            <TextBlock Grid.Row="4" 
                       Text="{Binding Instructions}" 
                       Foreground="#6b7280" FontFamily="Segoe UI"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,12,0,0"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="Cancel" 
                        Command="{Binding CancelTestCommand}"
                        Width="100" Height="40"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#f3f4f6"/>
                            <Setter Property="Foreground" Value="#6b7280"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="BorderBrush" Value="#d1d5db"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="15,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#e5e7eb"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- Start/Stop Watching Toggle -->
                <Button Width="150" Height="40" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#8B3D88"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Content" Value="▶ Start Watching"/>
                            <Setter Property="Command" Value="{Binding StartWatchingCommand}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="15,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7A3376"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                    <Setter Property="Background" Value="#ef4444"/>
                                    <Setter Property="Content" Value="⏹ Stop Watching"/>
                                    <Setter Property="Command" Value="{Binding StopWatchingCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="✓ Complete" 
                        Command="{Binding CompleteTestCommand}"
                        Width="120" Height="40">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#8B3D88"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="15,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7A3376"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
