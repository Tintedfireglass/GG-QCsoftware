<Window x:Class="LaptopQC.App.Views.UsbPortTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="🔌 USB Port Test" 
        Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:UsbPortTestViewModel />
    </Window.DataContext>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🔌 USB Port Test" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#e94560" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
        
        <!-- Port Count Selector -->
        <Border Grid.Row="1" Background="#0f3460" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Expected USB Ports" Foreground="#a0a0a0" FontSize="12"/>
                    <TextBlock Text="Set this to the number of physical USB ports on the laptop" 
                               Foreground="#606080" FontSize="11"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="-" Command="{Binding DecrementPortCountCommand}" 
                            Width="35" Height="35" FontSize="18" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2d2d44"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding ExpectedPortCount}" 
                               Foreground="#ffffff" FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="15,0"/>
                    <Button Content="+" Command="{Binding IncrementPortCountCommand}"
                            Width="35" Height="35" FontSize="18" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2d2d44"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Progress Bar -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <ProgressBar Value="{Binding ProgressPercent}" 
                         Minimum="0" Maximum="100"
                         Height="8" 
                         Background="#0f3460"
                         Foreground="#00d9ff"/>
            <TextBlock Text="{Binding ProgressText}" 
                       Foreground="#a0a0a0" 
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- USB Events List -->
        <Border Grid.Row="3" Background="#0f3460" CornerRadius="12" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Detected Insertions" 
                           Foreground="#e94560" FontWeight="SemiBold" 
                           Margin="0,0,0,10"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InsertionEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16213e" CornerRadius="6" Padding="10,8" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="#00d9ff" CornerRadius="10" 
                                                Width="20" Height="20" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PortNumber}" 
                                                       Foreground="#1a1a2e" FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- USB Version Badge -->
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#404060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsbVersion}" Value="USB 3.x">
                                                            <Setter Property="Background" Value="#00d9ff"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsbVersion}" Value="USB 2.0">
                                                            <Setter Property="Background" Value="#6070a0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UsbVersion}" FontSize="10" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#ffffff"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsbVersion}" Value="USB 3.x">
                                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" 
                                                   Foreground="#808080" FontSize="11" 
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        
                                        <TextBlock Grid.Column="3" Text="{Binding DeviceName}" 
                                                   Foreground="#ffffff" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Empty state -->
                <TextBlock Grid.Row="1" 
                           Text="No USB insertions detected yet.&#x0a;Click 'Start Watching' then plug in a USB device."
                           Foreground="#606080" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding InsertionEvents.Count, Converter={StaticResource InverseBoolToVisConverter}, FallbackValue=Visible}"/>
            </Grid>
        </Border>
        
        <!-- Instructions -->
        <TextBlock Grid.Row="4" 
                   Text="{Binding Instructions}" 
                   Foreground="#a0a0a0" 
                   FontSize="14"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,15,0,0"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Cancel" 
                    Command="{Binding CancelTestCommand}"
                    Width="100" Height="40"
                    Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2d2d44"/>
                        <Setter Property="Foreground" Value="#a0a0a0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3d3d54"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <!-- Start/Stop Watching Toggle -->
            <Button Width="140" Height="40" Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2d5a27"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Content" Value="▶ Start Watching"/>
                        <Setter Property="Command" Value="{Binding StartWatchingCommand}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3d7a37"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                <Setter Property="Background" Value="#e94560"/>
                                <Setter Property="Content" Value="⏹ Stop Watching"/>
                                <Setter Property="Command" Value="{Binding StopWatchingCommand}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Content="✓ Complete" 
                    Command="{Binding CompleteTestCommand}"
                    Width="120" Height="40">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#00d9ff"/>
                        <Setter Property="Foreground" Value="#1a1a2e"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33e6ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
