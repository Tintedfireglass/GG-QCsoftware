<Window x:Class="LaptopQC.App.Views.QCWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        mc:Ignorable="d"
        Title="QC Wizard" SizeToContent="Height" MinHeight="400" MaxHeight="700" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:QCWizardViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A3376"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e5e7eb"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="16" Padding="24"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <!-- Step 1: Preparation -->
            <StackPanel Visibility="{Binding IsPrepStep, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Step 1: Preparation" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Text="Refurbish ID / Asset Tag:" Margin="0,8" Foreground="#374151" FontFamily="Segoe UI"/>
                <TextBox Text="{Binding RefurbId, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="12,10" FontFamily="Segoe UI" FontSize="14"
                         Background="#f9fafb" BorderBrush="#d1d5db" BorderThickness="1"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Technician ID / Name:" Margin="0,0,0,4" Foreground="#374151" FontFamily="Segoe UI"/>
                <TextBox Text="{Binding TechnicianId, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,8" FontFamily="Segoe UI" FontSize="13"
                         Background="#f9fafb" BorderBrush="#d1d5db" BorderThickness="1"
                         Margin="0,0,0,16"/>

                <!-- Physical Condition -->
                <TextBlock Text="Physical Condition:" Margin="0,0,0,6" Foreground="#374151" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,0,0,16">
                    <RadioButton Content="A+  Excellent" GroupName="PhysicalCondition" Margin="0,0,16,4"
                                 IsChecked="{Binding PhysicalCondition, Converter={StaticResource EqualityConverter}, ConverterParameter='A+'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                    <RadioButton Content="A  Very Good" GroupName="PhysicalCondition" Margin="0,0,16,4"
                                 IsChecked="{Binding PhysicalCondition, Converter={StaticResource EqualityConverter}, ConverterParameter='A'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                    <RadioButton Content="B  Good" GroupName="PhysicalCondition" Margin="0,0,16,4"
                                 IsChecked="{Binding PhysicalCondition, Converter={StaticResource EqualityConverter}, ConverterParameter='B'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                    <RadioButton Content="C  Fair" GroupName="PhysicalCondition" Margin="0,0,16,4"
                                 IsChecked="{Binding PhysicalCondition, Converter={StaticResource EqualityConverter}, ConverterParameter='C'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                    <RadioButton Content="D  Poor" GroupName="PhysicalCondition" Margin="0,0,16,4"
                                 IsChecked="{Binding PhysicalCondition, Converter={StaticResource EqualityConverter}, ConverterParameter='D'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                    <RadioButton Content="E  Damaged" GroupName="PhysicalCondition" Margin="0,0,0,4"
                                 IsChecked="{Binding PhysicalCondition, Converter={StaticResource EqualityConverter}, ConverterParameter='E'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                </WrapPanel>

                <!-- Scratches and Dents -->
                <TextBlock Text="Scratches and Dents:" Margin="0,0,0,6" Foreground="#374151" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,0,0,24">
                    <RadioButton Content="None" GroupName="ScratchesAndDents" Margin="0,0,20,0"
                                 IsChecked="{Binding ScratchesAndDents, Converter={StaticResource EqualityConverter}, ConverterParameter='None'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                    <RadioButton Content="Minor" GroupName="ScratchesAndDents" Margin="0,0,20,0"
                                 IsChecked="{Binding ScratchesAndDents, Converter={StaticResource EqualityConverter}, ConverterParameter='Minor'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                    <RadioButton Content="Major" GroupName="ScratchesAndDents" Margin="0,0,0,0"
                                 IsChecked="{Binding ScratchesAndDents, Converter={StaticResource EqualityConverter}, ConverterParameter='Major'}"
                                 FontFamily="Segoe UI" FontSize="13" Foreground="#374151" Cursor="Hand"/>
                </WrapPanel>

                <Button Command="{Binding StartTestsCommand}" Content="Start QC Process" 
                        Style="{StaticResource PrimaryButton}" Height="44" FontSize="14"/>
            </StackPanel>

            <!-- Step 2: Automated Tests -->
            <StackPanel Visibility="{Binding IsAutomatedStep, Converter={StaticResource BoolToVisibilityConverter}}"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Step 2: Automated System Checks" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                
                <ProgressBar Value="{Binding AutomatedProgress}" Height="10" 
                             Background="#e5e7eb" Foreground="#8B3D88" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding AutomatedStatus}" HorizontalAlignment="Center" FontSize="14" Foreground="#6b7280" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Step 3: Interactive Tests -->
            <StackPanel Visibility="{Binding IsInteractiveStep, Converter={StaticResource BoolToVisibilityConverter}}"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🧪" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Step 3: Interactive Tests" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding InteractiveInstruction}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,24" Foreground="#6C6B6B" FontFamily="Segoe UI"/>

                <Button Command="{Binding RunKeyboardTestCommand}" Content="Run Keyboard Test" 
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsKeyboardNext, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="50" Margin="0,8" FontSize="14"/>

                <Button Command="{Binding RunTrackpadTestCommand}" Content="Run Trackpad Test" 
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsTrackpadNext, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="50" Margin="0,8" FontSize="14"/>
                
                <Button Command="{Binding RunUsbTestCommand}" Content="Run USB Port Test" 
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsUsbNext, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="50" Margin="0,8" FontSize="14"/>
                
                <Button Command="{Binding RunAvTestCommand}" Content="Run Audio &amp; Video Test" 
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsAvNext, Converter={StaticResource BoolToVisibilityConverter}}"
                        Height="50" Margin="0,8" FontSize="14"/>

                <!-- WiFi / Network Test -->
                <StackPanel Visibility="{Binding IsWifiNext, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Connect this machine to WiFi and/or plug in an Ethernet cable."
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,8" 
                               Foreground="#6b7280" FontSize="13" FontFamily="Segoe UI"/>
                    
                    <!-- Live connection status -->
                    <Border Background="#f3f4f6" BorderBrush="{DynamicResource BorderGreyDarkBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="14,10" Margin="0,4,0,12" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- WiFi -->
                            <TextBlock Text="{Binding IsWifiLiveConnected, Converter={StaticResource BoolToPassFailConverter}}"
                                       Foreground="{Binding IsWifiLiveConnected, Converter={StaticResource BoolToColorConverter}}"
                                       FontFamily="Segoe UI" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding WifiLiveStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,12,0"/>
                            
                            <!-- Separator -->
                            <TextBlock Text=" | " Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0"/>

                            <!-- Ethernet -->
                            <TextBlock Text="{Binding IsEthernetLiveConnected, Converter={StaticResource BoolToPassFailConverter}}"
                                       Foreground="{Binding IsEthernetLiveConnected, Converter={StaticResource BoolToColorConverter}}"
                                       FontFamily="Segoe UI" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding EthernetLiveStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Command="{Binding RunWifiTestCommand}" Content="🌐 Test Network Connectivity" 
                            Style="{StaticResource PrimaryButton}"
                            Height="50" Margin="0,4" FontSize="14"/>
                </StackPanel>

                <!-- Bluetooth Test -->
                <StackPanel Visibility="{Binding IsBluetoothNext, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Ensure Bluetooth is enabled in Windows Settings before running."
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"
                               Foreground="#6b7280" FontSize="13" FontFamily="Segoe UI"/>
                    <Button Command="{Binding RunBluetoothTestCommand}" Content="🔵 Test Bluetooth"
                            Style="{StaticResource PrimaryButton}"
                            Height="50" Margin="0,8" FontSize="14"/>
                </StackPanel>

                <!-- Charger / Charging Test -->
                <StackPanel Visibility="{Binding IsChargerNext, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Plug in the power adapter before running this test. Note: ensure battery is not at full charge for accurate detection."
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"
                               Foreground="#6b7280" FontSize="13" FontFamily="Segoe UI"/>
                    <Button Command="{Binding RunChargerTestCommand}" Content="⚡ Test Charger / Charging"
                            Style="{StaticResource PrimaryButton}"
                            Height="50" Margin="0,8" FontSize="14"/>
                </StackPanel>
                
                <!-- Network check status (shown while/after testing) -->
                <TextBlock Text="{Binding WifiStatus}" 
                           Visibility="{Binding IsCheckingNetwork, Converter={StaticResource BoolToVisibilityConverter}}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="14" Foreground="#0891b2" FontFamily="Segoe UI"/>
                <TextBlock Text="{Binding WifiStatus}" 
                           Visibility="{Binding NetworkCheckDone, Converter={StaticResource BoolToVisibilityConverter}}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Step 4: Report -->
            <StackPanel Visibility="{Binding IsReportStep, Converter={StaticResource BoolToVisibilityConverter}}"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="✓" FontFamily="Segoe UI" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SuccessYesBrush}"/>
                    <TextBlock Text="QC Complete" FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Grid Width="80" Height="80" Margin="0,0,0,6" HorizontalAlignment="Center">
                    <!-- Animated Checkbox Square -->
                    <Rectangle Stroke="{DynamicResource SuccessYesBrush}" StrokeThickness="5" RadiusX="16" RadiusY="16" Fill="Transparent" StrokeDashArray="400,400" StrokeDashOffset="400">
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="400" To="0" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>

                    <!-- Animated Checkmark -->
                    <Path Stroke="{DynamicResource SuccessYesBrush}" StrokeThickness="6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 25,45 L 40,60 L 65,30" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeDashArray="100,100" StrokeDashOffset="100">
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="100" To="0" BeginTime="0:0:0.4" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
                
                <TextBlock Text="{Binding CompletionMessage}" FontSize="18" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI"
                           Foreground="{Binding OverallGrade, Converter={StaticResource GradeToColorConverter}}"/>
                
                <StackPanel Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,6,0,8" HorizontalAlignment="Center">
                    <TextBlock Text="PRAMAAN Certification Verification" HorizontalAlignment="Center" FontSize="12" Foreground="#6b7280" Margin="0,0,0,4"/>
                    <Border BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="4" Padding="6" Background="White">
                        <Image Source="{Binding QrCodeImage}" Width="100" Height="100" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding ReportPath}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="#9ca3af" FontSize="11" FontFamily="Segoe UI"/>
                
                <TextBlock Text="{Binding SubmissionStatus}" FontSize="14" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{Binding SubmissionStatusColor}" FontFamily="Segoe UI"/>

                <Button Command="{Binding OpenReportCommand}" Content="View Report" 
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
