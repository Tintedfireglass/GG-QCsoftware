<Window x:Class="LaptopQC.App.Views.BluetoothTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppDisplayName}" Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f5f5">

    <Grid>
        <Border Background="White"
                BorderBrush="{DynamicResource BorderGreyBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="20"
                Padding="30"
                Effect="{StaticResource CardShadow}">
            <StackPanel>
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#eff6ff" CornerRadius="50" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🔵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Bluetooth Test" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}"/>
                    <TextBlock Text="Checking Bluetooth adapter and scanning for devices..."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource AppFontFamily}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Background="{DynamicResource BorderGreyBrush}" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                    <TextBlock x:Name="LoadingText" Text="Scanning Bluetooth adapter..."
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Results -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="0,0,0,16">

                    <!-- Adapter Status -->
                    <Border Background="{DynamicResource BorderGreyBrush}" BorderBrush="{DynamicResource BorderGreyDarkBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AdapterIcon" Text="📡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI Emoji"/>
                            <StackPanel>
                                <TextBlock Text="Bluetooth Adapter" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}" FontSize="13"/>
                                <TextBlock x:Name="AdapterStatusText" Text="-" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Discovery Scan Status -->
                    <Border Background="{DynamicResource BorderGreyBrush}" BorderBrush="{DynamicResource BorderGreyDarkBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScanIcon" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI Emoji"/>
                            <StackPanel>
                                <TextBlock Text="Radio Scan" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}" FontSize="13"/>
                                <TextBlock x:Name="ScanStatusText" Text="-" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Overall Result -->
                    <Border x:Name="OverallResultBorder" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock x:Name="OverallResultText" HorizontalAlignment="Center"
                                   FontWeight="SemiBold" FontFamily="Segoe UI" FontSize="13"/>
                    </Border>
                </StackPanel>

                <!-- Continue Button -->
                <Button x:Name="ContinueButton"
                        Content="Continue"
                        Click="ContinueButton_Click"
                        IsEnabled="False"
                        Padding="12,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        FontFamily="{DynamicResource AppFontFamily}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource BorderGreyDarkBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
