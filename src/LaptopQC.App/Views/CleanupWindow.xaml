<Window x:Class="LaptopQC.App.Views.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        xmlns:conv="clr-namespace:LaptopQC.App.Converters"
        Title="Junk Cleanup" Height="560" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5">

    <Window.DataContext>
        <vm:CleanupViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B3D88"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B3D88"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1f2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A3376"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#d1d5db"/>
                    <Setter Property="Foreground" Value="#9ca3af"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B3D88"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#8B3D88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#fef2f2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="#d1d5db"/>
                    <Setter Property="Foreground" Value="#9ca3af"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallTestButton" TargetType="Button">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A3376"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#d1d5db"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="StickyListView" TargetType="ListView">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="ScrollViewer"
                                          Focusable="False"
                                          Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <GridViewHeaderRowPresenter x:Name="HeaderPresenter"
                                                                DockPanel.Dock="Top"
                                                                Margin="0,0,0,2"
                                                                Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                                ColumnHeaderContainerStyle="{Binding Path=View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                                                ColumnHeaderTemplate="{Binding Path=View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                                ColumnHeaderTemplateSelector="{Binding Path=View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                                                ColumnHeaderStringFormat="{Binding Path=View.ColumnHeaderStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                                                AllowsColumnReorder="{Binding Path=View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ItemsPresenter/>
                                </DockPanel>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Junk Cleanup" Style="{StaticResource HeaderText}" Margin="0,0,16,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total" Style="{StaticResource InfoLabel}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding TotalSizeLabel}" Style="{StaticResource ValueText}" Margin="0,0,12,0"/>
                <TextBlock Text="Selected" Style="{StaticResource InfoLabel}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding SelectedSizeLabel}" Style="{StaticResource ValueText}" Margin="0,0,16,0"/>
                <Button Content="Scan"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Clean Selected"
                        Command="{Binding CleanCommand}"
                        IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource OutlineButton}" Padding="12,6" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Cleanup Categories" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,8,0"/>
                        <Button Content="Select None" Command="{Binding SelectNoneCommand}" Style="{StaticResource OutlineButton}" Padding="10,6"/>
                    </StackPanel>
                </Grid>
            <ListView x:Name="CategoriesList"
                      Grid.Row="1"
                      ItemsSource="{Binding Categories}"
                      Style="{StaticResource StickyListView}">
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Width="50">
                            <GridViewColumn.Header>
                                <TextBlock Text="Use" Style="{StaticResource InfoLabel}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Name}" Width="170">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <GridViewColumnHeader Content="Category" Tag="Name" Click="GridViewColumnHeader_Click"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="260">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <GridViewColumnHeader Content="Description" Tag="Description" Click="GridViewColumnHeader_Click"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Files" DisplayMemberBinding="{Binding FileCount}" Width="70">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <GridViewColumnHeader Content="Files" Tag="FileCount" Click="GridViewColumnHeader_Click"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLabel}" Width="90">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <GridViewColumnHeader Content="Size" Tag="SizeBytes" Click="GridViewColumnHeader_Click"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Approx"
                                        DisplayMemberBinding="{Binding ApproximateLabel}"
                                        Width="{Binding DataContext.ShowApproxColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToWidthConverter}, ConverterParameter=70}">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <GridViewColumnHeader Content="Approx" Tag="IsApproximate" Click="GridViewColumnHeader_Click"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Actions" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Deep Scan"
                                            Style="{StaticResource SmallTestButton}"
                                            Padding="10,4"
                                            IsEnabled="{Binding CanDeepScan}"
                                            Visibility="{Binding WindowsUpdateVisibility}"
                                            Command="{Binding DataContext.DeepScanWindowsUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Available" DisplayMemberBinding="{Binding AvailabilityLabel}" Width="80">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <GridViewColumnHeader Content="Available" Tag="IsAvailable" Click="GridViewColumnHeader_Click"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#f3f4f6" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,12,5,0">
            <StackPanel>
                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                             Background="#e5e7eb"
                             Foreground="#0f766e"/>
                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibilityConverter}}"
                             Background="#e5e7eb"
                             Foreground="#8B3D88"
                             Margin="0,6,0,0"/>
                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsDeepScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                             Background="#e5e7eb"
                             Foreground="#2563eb"
                             Margin="0,6,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource InfoLabel}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding CurrentOperation}" Foreground="#9ca3af" FontSize="11" TextWrapping="Wrap" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
