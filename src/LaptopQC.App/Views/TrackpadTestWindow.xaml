<Window x:Class="LaptopQC.App.Views.TrackpadTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="🖱️ Trackpad Test" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e"
        ResizeMode="NoResize"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel">
    
    <Window.DataContext>
        <vm:TrackpadTestViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <Style x:Key="TestItemBorder" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        
        <Style x:Key="TestItemLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a0a0a0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="TestItemIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🖱️ Trackpad Test" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#e94560" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
        
        <!-- Progress Bar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <ProgressBar Value="{Binding ProgressPercent}" 
                         Minimum="0" Maximum="100"
                         Height="8" 
                         Background="#0f3460"
                         Foreground="#00d9ff"/>
            <TextBlock Text="{Binding ProgressText}" 
                       Foreground="#a0a0a0" 
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Test Area - Interactive Zone -->
        <Border Grid.Row="2" Background="#0f3460" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Test Status Indicators -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                    <!-- Movement -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MovementTested}" Value="True">
                                        <Setter Property="Background" Value="#00d9ff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="↔️">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                        <Setter Property="Foreground" Value="#a0a0a0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MovementTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Movement">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MovementTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Left Click -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LeftClickTested}" Value="True">
                                        <Setter Property="Background" Value="#00d9ff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="🖱️">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                        <Setter Property="Foreground" Value="#a0a0a0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LeftClickTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Left Click">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LeftClickTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Right Click -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RightClickTested}" Value="True">
                                        <Setter Property="Background" Value="#00d9ff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="🖱️">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                        <Setter Property="Foreground" Value="#a0a0a0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RightClickTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Right Click">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RightClickTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Scroll -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScrollTested}" Value="True">
                                        <Setter Property="Background" Value="#00d9ff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="↕️">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                        <Setter Property="Foreground" Value="#a0a0a0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScrollTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Scroll">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScrollTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                
                <!-- Interactive Test Zone -->
                <Border Grid.Row="1" Background="#1a1a2e" CornerRadius="8" 
                        BorderBrush="#2d2d44" BorderThickness="2">
                    <TextBlock Text="🎯 Move cursor and click here to test trackpad" 
                               Foreground="#606080" 
                               FontSize="16"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        
        <!-- Instructions -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding Instructions}" 
                   Foreground="#a0a0a0" 
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Cancel" 
                    Command="{Binding CancelTestCommand}"
                    Width="120" Height="40"
                    Margin="0,0,20,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2d2d44"/>
                        <Setter Property="Foreground" Value="#a0a0a0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8"
                                            Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3d3d54"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Content="✓ Complete Test" 
                    Command="{Binding CompleteTestCommand}"
                    Width="150" Height="40">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#00d9ff"/>
                        <Setter Property="Foreground" Value="#1a1a2e"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8"
                                            Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33e6ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
