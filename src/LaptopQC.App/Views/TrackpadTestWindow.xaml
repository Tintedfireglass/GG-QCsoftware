<Window x:Class="LaptopQC.App.Views.TrackpadTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="🖱️ Trackpad Test" 
        Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        ResizeMode="NoResize"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel">
    
    <Window.DataContext>
        <vm:TrackpadTestViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <Style x:Key="TestItemBorder" TargetType="Border">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
        
        <Style x:Key="TestItemLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6b7280"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="TestItemIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    
    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="16" Padding="20"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="🖱️" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Trackpad Test" 
                           FontSize="22" FontWeight="SemiBold" 
                           Foreground="#22c55e" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Progress Bar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Minimum="0" Maximum="100"
                             Height="8" 
                             Background="#e5e7eb"
                             Foreground="#22c55e"/>
                <TextBlock Text="{Binding ProgressText}" 
                           Foreground="#6b7280" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <!-- Test Area -->
            <Border Grid.Row="2" Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Test Status Indicators -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                        <!-- Movement -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MovementTested}" Value="True">
                                            <Setter Property="Background" Value="#dcfce7"/>
                                            <Setter Property="BorderBrush" Value="#22c55e"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="↔️">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                            <Setter Property="Foreground" Value="#9ca3af"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MovementTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#22c55e"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Movement">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MovementTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#15803d"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        
                        <!-- Left Click -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftClickTested}" Value="True">
                                            <Setter Property="Background" Value="#dcfce7"/>
                                            <Setter Property="BorderBrush" Value="#22c55e"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="🖱️">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                            <Setter Property="Foreground" Value="#9ca3af"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LeftClickTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#22c55e"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Left Click">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LeftClickTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#15803d"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        
                        <!-- Right Click -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightClickTested}" Value="True">
                                            <Setter Property="Background" Value="#dcfce7"/>
                                            <Setter Property="BorderBrush" Value="#22c55e"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="🖱️">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                            <Setter Property="Foreground" Value="#9ca3af"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RightClickTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#22c55e"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Right Click">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RightClickTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#15803d"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        
                        <!-- Scroll -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TestItemBorder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScrollTested}" Value="True">
                                            <Setter Property="Background" Value="#dcfce7"/>
                                            <Setter Property="BorderBrush" Value="#22c55e"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="↕️">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemIcon}">
                                            <Setter Property="Foreground" Value="#9ca3af"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScrollTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#22c55e"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Scroll">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestItemLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScrollTested}" Value="True">
                                                    <Setter Property="Foreground" Value="#15803d"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    
                    <!-- Interactive Test Zone -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" 
                            BorderBrush="#d1d5db" BorderThickness="2,2,2,2">
                        <TextBlock Text="🎯 Move cursor and click here to test trackpad" 
                                   Foreground="#9ca3af" FontFamily="Segoe UI"
                                   FontSize="15"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Instructions -->
            <TextBlock Grid.Row="3" 
                       Text="{Binding Instructions}" 
                       Foreground="#6b7280" FontFamily="Segoe UI"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Cancel" 
                        Command="{Binding CancelTestCommand}"
                        Width="120" Height="40"
                        Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#f3f4f6"/>
                            <Setter Property="Foreground" Value="#6b7280"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="BorderBrush" Value="#d1d5db"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="20,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#e5e7eb"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="✓ Complete Test" 
                        Command="{Binding CompleteTestCommand}"
                        Width="150" Height="40">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#22c55e"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6"
                                                Padding="20,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16a34a"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
