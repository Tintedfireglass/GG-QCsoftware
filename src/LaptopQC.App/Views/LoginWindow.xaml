<Window x:Class="LaptopQC.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - QC Tool" Height="400" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f1f5f9">
    
    <Grid>
        <Border Background="White" 
                CornerRadius="12" 
                Margin="20" 
                Padding="30"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="🔐" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="QC Tool Login" FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Center" Foreground="#1e293b"/>
                    <TextBlock Text="Login to associate results with your account" 
                               FontSize="12" Foreground="#64748b" 
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#374151"/>
                    <TextBox x:Name="UsernameBox" 
                             Padding="10" 
                             FontSize="14"
                             Background="#f8fafc"
                             BorderBrush="#e2e8f0"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#374151"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Padding="10" 
                                 FontSize="14"
                                 Background="#f8fafc"
                                 BorderBrush="#e2e8f0"
                                 BorderThickness="1"
                                 KeyDown="PasswordBox_KeyDown"/>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage" 
                           Grid.Row="3" 
                           Foreground="#ef4444" 
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,12"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton"
                        Grid.Row="4" 
                        Content="Login" 
                        Click="LoginButton_Click"
                        Padding="12,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#3b82f6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Loading indicator -->
                <TextBlock x:Name="LoadingText" 
                           Grid.Row="5" 
                           Text="Logging in..." 
                           HorizontalAlignment="Center"
                           Foreground="#64748b"
                           Visibility="Collapsed"
                           Margin="0,10,0,0"/>

                <!-- Skip link -->
                <Button Grid.Row="7" 
                        Content="Skip - Work Offline" 
                        Click="SkipButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#6b7280"
                        Cursor="Hand"
                        FontSize="12"
                        HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
