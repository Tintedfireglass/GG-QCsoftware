<Window x:Class="LaptopQC.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activation - PRAMAAN" Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f5f5">
    
    <Grid>
        <Border Background="White" 
                BorderBrush="#e5e7eb"
                BorderThickness="1"
                CornerRadius="12" 
                Margin="20" 
                Padding="30"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="#dcfce7" CornerRadius="50" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🔑" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Activate PRAMAAN" FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Center" Foreground="#1f2937" FontFamily="Segoe UI"/>
                    <TextBlock Text="Enter your 16-digit license key to unlock features" 
                               FontSize="12" Foreground="#6b7280" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- License Key Stack -->
                <StackPanel x:Name="LicenseLoginPanel" Grid.Row="2" Visibility="Visible">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="16-Digit License Key" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#374151" FontFamily="Segoe UI"/>
                        <TextBox x:Name="LicenseBox" 
                                 Padding="12,10" 
                                 FontSize="14"
                                 FontFamily="Segoe UI"
                                 Background="#f9fafb"
                                 BorderBrush="#d1d5db"
                                 BorderThickness="1"
                                 MaxLength="19"
                                 TextAlignment="Center"
                                 CharacterCasing="Upper"
                                 KeyDown="LicenseBox_KeyDown"/>
                    </StackPanel>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage" 
                           Grid.Row="3" 
                           Foreground="#dc2626" 
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,12"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton"
                        Grid.Row="4" 
                        Content="Activate" 
                        Click="LoginButton_Click"
                        Padding="12,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#8B3D88"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7A3376"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


                <!-- Loading indicator -->
                <TextBlock x:Name="LoadingText" 
                           Grid.Row="5" 
                           Text="Activating..." 
                           HorizontalAlignment="Center"
                           Foreground="#6b7280"
                           FontFamily="Segoe UI"
                           Visibility="Collapsed"
                           Margin="0,12,0,0"/>

                <!-- Skip link -->
                <Button Grid.Row="7" 
                        Content="Skip - Work Offline" 
                        Click="SkipButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#6b7280"
                        Cursor="Hand"
                        FontSize="12"
                        FontFamily="Segoe UI"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
