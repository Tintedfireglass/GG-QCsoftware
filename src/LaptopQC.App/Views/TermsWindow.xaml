<Window x:Class="LaptopQC.App.Views.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRAMAAN" 
        Height="620" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="32,28,32,24" VerticalAlignment="Center">

            <!-- Header -->
            <TextBlock Text="Welcome to PRAMAAN" FontSize="20" FontWeight="Bold" 
                       Foreground="#111827" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
            <TextBlock Text="Before you continue, please review and accept:" FontSize="13" 
                       Foreground="#6b7280" HorizontalAlignment="Center" Margin="0,8,0,20" FontFamily="Segoe UI"/>

            <!-- Links removed per request -->

            <!-- Legal Text Tabs -->
            <Border BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Background="#f9fafb" Margin="0,0,0,16">
                <TabControl Height="300" Background="Transparent" BorderThickness="0" Padding="6">
                    <TabItem Header="Terms">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TermsTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#111827"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Margin="12"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Privacy">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="PrivacyTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#111827"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Margin="12"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="EULA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="EulaTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#111827"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Margin="12"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="ELA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="ElaTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#111827"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Margin="12"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Checkbox -->
            <CheckBox x:Name="AcceptCheckbox" HorizontalAlignment="Center" Margin="0,0,0,20" 
                      FontFamily="Segoe UI" FontSize="13">
                <TextBlock Text="I agree to the Terms, Privacy Policy, EULA, and ELA" TextWrapping="Wrap"/>
            </CheckBox>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Decline" Click="Decline_Click" 
                        Width="100" Height="38" FontSize="13" FontFamily="Segoe UI"
                        Background="#f3f4f6" Foreground="#374151" BorderBrush="#d1d5db" BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Continue" Click="Accept_Click"
                        IsEnabled="{Binding IsChecked, ElementName=AcceptCheckbox}"
                        Width="120" Height="38" FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold"
                        Background="#7A3376" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Margin="12,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

