<Window x:Class="LaptopQC.App.Views.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRAMAAN" 
        Height="280" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="32,28,32,24" VerticalAlignment="Center">

            <!-- Header -->
            <TextBlock Text="Welcome to PRAMAAN" FontSize="20" FontWeight="Bold" 
                       Foreground="#111827" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
            <TextBlock Text="Before you continue, please review and accept:" FontSize="13" 
                       Foreground="#6b7280" HorizontalAlignment="Center" Margin="0,8,0,20" FontFamily="Segoe UI"/>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock>
                    <Hyperlink NavigateUri="https://gadgetguruz.com" RequestNavigate="Link_Navigate" Foreground="#0891b2" FontWeight="SemiBold">
                        Terms &amp; Conditions
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="  •  " Foreground="#9ca3af" VerticalAlignment="Center"/>
                <TextBlock>
                    <Hyperlink NavigateUri="https://gadgetguruz.com" RequestNavigate="Link_Navigate" Foreground="#0891b2" FontWeight="SemiBold">
                        Privacy Policy
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Checkbox -->
            <CheckBox x:Name="AcceptCheckbox" HorizontalAlignment="Center" Margin="0,0,0,20" 
                      FontFamily="Segoe UI" FontSize="13">
                <TextBlock Text="I agree to the Terms &amp; Conditions and Privacy Policy" TextWrapping="Wrap"/>
            </CheckBox>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Decline" Click="Decline_Click" 
                        Width="100" Height="38" FontSize="13" FontFamily="Segoe UI"
                        Background="#f3f4f6" Foreground="#374151" BorderBrush="#d1d5db" BorderThickness="1"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Continue" Click="Accept_Click"
                        IsEnabled="{Binding IsChecked, ElementName=AcceptCheckbox}"
                        Width="120" Height="38" FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold"
                        Background="#16a34a" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Margin="12,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
