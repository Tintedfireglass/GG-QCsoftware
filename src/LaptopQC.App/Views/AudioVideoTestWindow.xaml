<Window x:Class="LaptopQC.App.Views.AudioVideoTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="Audio &amp; Video Test" 
        Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:AudioVideoTestViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" x:Key="DefaultButton">
            <Setter Property="Background" Value="#f3f4f6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e5e7eb"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PassButton" BasedOn="{StaticResource DefaultButton}">
            <Setter Property="Background" Value="#8B3D88"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A3376"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="FailButton" BasedOn="{StaticResource DefaultButton}">
            <Setter Property="Background" Value="#ef4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#dc2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="12" Margin="16" Padding="24"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="🔊" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Audio &amp; Video Diagnostics" 
                           FontSize="22" FontWeight="SemiBold" Foreground="#8B3D88" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Progress/Step -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="{Binding CurrentStepName}" 
                           FontSize="16" FontWeight="SemiBold" Foreground="#0891b2" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Instructions}" 
                           FontSize="13" Foreground="#6b7280" 
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Content Area -->
            <Grid Grid.Row="2" Margin="0,8">
                
                <!-- Speaker Test -->
                <StackPanel Visibility="{Binding IsSpeakerTestActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <!-- Left Speaker Section -->
                    <Border Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🔊 Left Speaker" FontWeight="SemiBold" FontSize="15"/>
                                <Button Content="▶ Play Test Sound" Command="{Binding TestLeftSpeakerCommand}" 
                                        Style="{StaticResource DefaultButton}"
                                        Width="160" Height="36" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✓ Pass" Command="{Binding PassLeftSpeakerCommand}" 
                                        Style="{StaticResource PassButton}" Width="80" Height="36"
                                        IsEnabled="{Binding LeftSpeakerTested, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="✗ Fail" Command="{Binding FailLeftSpeakerCommand}" 
                                        Style="{StaticResource FailButton}" Width="80" Height="36"
                                        IsEnabled="{Binding LeftSpeakerTested, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="{Binding LeftSpeakerPassed, Converter={StaticResource BoolToPassFailConverter}}" 
                                           FontSize="20" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{Binding LeftSpeakerPassed, Converter={StaticResource BoolToColorConverter}}"
                                           Visibility="{Binding LeftSpeakerTested, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Right Speaker Section -->
                    <Border Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🔊 Right Speaker" FontWeight="SemiBold" FontSize="15"/>
                                <Button Content="▶ Play Test Sound" Command="{Binding TestRightSpeakerCommand}" 
                                        Style="{StaticResource DefaultButton}"
                                        Width="160" Height="36" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✓ Pass" Command="{Binding PassRightSpeakerCommand}" 
                                        Style="{StaticResource PassButton}" Width="80" Height="36"
                                        IsEnabled="{Binding RightSpeakerTested, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="✗ Fail" Command="{Binding FailRightSpeakerCommand}" 
                                        Style="{StaticResource FailButton}" Width="80" Height="36"
                                        IsEnabled="{Binding RightSpeakerTested, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="{Binding RightSpeakerPassed, Converter={StaticResource BoolToPassFailConverter}}" 
                                           FontSize="20" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{Binding RightSpeakerPassed, Converter={StaticResource BoolToColorConverter}}"
                                           Visibility="{Binding RightSpeakerTested, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </StackPanel>

                <!-- Mic Test -->
                <StackPanel Visibility="{Binding IsMicTestActive, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16">
                        <Button Content="🔴 Start Recording" Command="{Binding StartRecordingCommand}" 
                                Style="{StaticResource DefaultButton}"
                                Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisConverter}}"
                                Width="160"/>
                        <Button Content="⏹ Stop Recording" Command="{Binding StopRecordingCommand}" 
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource FailButton}" Width="160"/>
                        
                        <Button Content="▶ Playback" Command="{Binding PlaybackRecordingCommand}" 
                                Style="{StaticResource DefaultButton}"
                                IsEnabled="{Binding CanPlayback}"
                                Margin="20,5,5,5" Width="160"/>
                    </StackPanel>

                    <TextBlock Text="Did you clearly hear your voice in the playback?" HorizontalAlignment="Center" Margin="0,24,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Yes (Pass)" Command="{Binding PassMicTestCommand}" Style="{StaticResource PassButton}" Width="110"/>
                        <Button Content="No (Fail)" Command="{Binding FailMicTestCommand}" Style="{StaticResource FailButton}" Width="110"/>
                    </StackPanel>
                </StackPanel>

                <!-- 3.5mm Jack Test -->
                <StackPanel Visibility="{Binding IsJackTestActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <!-- Detection Status -->
                    <Border Background="#f9fafb" BorderBrush="#e5e7eb" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="🎧 Headphone Detection" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding JackDetectionStatus}" 
                                       FontSize="14" Margin="0,8,0,0"
                                       Foreground="{Binding JackDetected, Converter={StaticResource BoolToColorConverter}}"/>
                            <TextBlock Text="{Binding JackDeviceName}" 
                                       FontSize="12" Foreground="#6b7280" Margin="0,4,0,0"
                                       Visibility="{Binding JackDetected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Play + Pass/Fail -->
                    <Button Content="🔊 Play Test Sound (through headphones)" 
                            Command="{Binding PlayJackTestSoundCommand}" 
                            Style="{StaticResource DefaultButton}"
                            IsEnabled="{Binding JackDetected}"
                            HorizontalAlignment="Center" Width="300" Height="44" FontSize="14" Margin="0,12"/>

                    <TextBlock Text="Did you clearly hear the test tone through the headphones?" 
                               HorizontalAlignment="Center" Margin="0,16,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Yes (Pass)" Command="{Binding PassJackTestCommand}" Style="{StaticResource PassButton}" Width="110"/>
                        <Button Content="No (Fail)" Command="{Binding FailJackTestCommand}" Style="{StaticResource FailButton}" Width="110"/>
                    </StackPanel>
                </StackPanel>

                <!-- Camera Test -->
                <StackPanel Visibility="{Binding IsCameraTestActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="📷 Open Camera App" Command="{Binding OpenCameraCommand}" 
                            Style="{StaticResource DefaultButton}"
                            HorizontalAlignment="Center" Width="220" Height="60" FontSize="16" Margin="0,20"/>
                    
                    <TextBlock Text="Did the camera open and show the video feed correctly?" HorizontalAlignment="Center" Margin="0,24,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Yes (Pass)" Command="{Binding PassCameraTestCommand}" Style="{StaticResource PassButton}" Width="110"/>
                        <Button Content="No (Fail)" Command="{Binding FailCameraTestCommand}" Style="{StaticResource FailButton}" Width="110"/>
                    </StackPanel>
                </StackPanel>

                <!-- Complete -->
                <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ResultMessage}" 
                               FontSize="18" FontWeight="SemiBold" 
                               Foreground="{Binding Passed, Converter={StaticResource BoolToColorConverter}}"
                               HorizontalAlignment="Center" Margin="0,30"/>
                    
                    <Button Content="Close" Click="CloseButton_Click" 
                            Style="{StaticResource DefaultButton}"
                            HorizontalAlignment="Center" Width="130" Margin="0,20"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
