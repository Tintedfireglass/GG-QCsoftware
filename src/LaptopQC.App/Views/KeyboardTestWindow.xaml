<Window x:Class="LaptopQC.App.Views.KeyboardTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="⌨️ Keyboard Test" 
        Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.DataContext>
        <vm:KeyboardTestViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Key button base style -->
        <Style x:Key="KeyButton" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        
        <!-- Key label style -->
        <Style x:Key="KeyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⌨️ Keyboard Test" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#e94560" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>
        
        <!-- Progress Bar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <ProgressBar Value="{Binding ProgressPercent}" 
                         Minimum="0" Maximum="100"
                         Height="8" 
                         Background="#0f3460"
                         Foreground="#00d9ff"/>
            <TextBlock Text="{Binding ProgressText}" 
                       Foreground="#a0a0a0" 
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Keyboard Layout -->
        <Border Grid.Row="2" Background="#0f3460" CornerRadius="12" Padding="15">
            <ItemsControl ItemsSource="{Binding Keys}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Height="280"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource KeyPositionConverter}" ConverterParameter="X">
                                    <Binding Path="Column"/>
                                    <Binding Path="Width"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Canvas.Top">
                            <Setter.Value>
                                <Binding Path="Row" Converter="{StaticResource KeyPositionConverter}" ConverterParameter="Y"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Margin="1" 
                                MinHeight="40"
                                Width="{Binding Width, Converter={StaticResource KeyWidthConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#16213e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTested}" Value="True">
                                            <Setter Property="Background" Value="#00d9ff"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Label}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontSize="11" 
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#a0a0a0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTested}" Value="True">
                                                <Setter Property="Foreground" Value="#1a1a2e"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        
        <!-- Instructions -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding Instructions}" 
                   Foreground="#a0a0a0" 
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Cancel" 
                    Command="{Binding CancelTestCommand}"
                    Width="120" Height="40"
                    Margin="0,0,20,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2d2d44"/>
                        <Setter Property="Foreground" Value="#a0a0a0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8"
                                            Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3d3d54"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Content="✓ Complete Test" 
                    Command="{Binding CompleteTestCommand}"
                    Width="150" Height="40">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#00d9ff"/>
                        <Setter Property="Foreground" Value="#1a1a2e"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8"
                                            Padding="20,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33e6ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
