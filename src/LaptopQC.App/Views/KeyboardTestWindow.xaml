<Window x:Class="LaptopQC.App.Views.KeyboardTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaptopQC.App.ViewModels"
        Title="⌨️ Keyboard Test" 
        Height="600" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.DataContext>
        <vm:KeyboardTestViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Key button base style -->
        <Style x:Key="KeyButton" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BorderGreyBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        
        <!-- Key label style -->
        <Style x:Key="KeyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Border Background="White" BorderBrush="{DynamicResource BorderGreyBrush}" BorderThickness="1" CornerRadius="12" Margin="16" Padding="20"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⌨️" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Keyboard Test" 
                               FontSize="22" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrandPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <CheckBox Content="Has Numpad" 
                          IsChecked="{Binding ShowNumpad}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontFamily="Segoe UI"/>
            </Grid>
            
            <!-- Progress Bar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <ProgressBar Value="{Binding ProgressPercent}" 
                             Minimum="0" Maximum="100"
                             Height="8" 
                             Background="{DynamicResource BorderGreyBrush}"
                             Foreground="{DynamicResource BrandPrimaryBrush}"/>
                <TextBlock Text="{Binding ProgressText}" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <!-- Keyboard Layout -->
            <Border Grid.Row="2" Background="#f9fafb" BorderBrush="{DynamicResource BorderGreyBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                <ItemsControl ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Height="350"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource KeyPositionConverter}" ConverterParameter="X">
                                        <Binding Path="Column"/>
                                        <Binding Path="Width"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <Binding Path="Row" Converter="{StaticResource KeyPositionConverter}" ConverterParameter="Y"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Margin="1" 
                                    MinHeight="40"
                                    Width="{Binding Width, Converter={StaticResource KeyWidthConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BorderGreyBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderGreyDarkBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTested}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Label}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           FontSize="11" 
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTested}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            
            <!-- Instructions -->
            <TextBlock Grid.Row="3" 
                       Text="{Binding Instructions}" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontFamily="Segoe UI"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
            
            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Cancel" 
                        Command="{Binding CancelTestCommand}"
                        Width="120" Height="40"
                        Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#f3f4f6"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderGreyDarkBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="20,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BorderGreyBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="✓ Complete Test" 
                        Command="{Binding CompleteTestCommand}"
                        Width="150" Height="40">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6"
                                                Padding="20,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
