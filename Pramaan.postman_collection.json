            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/licenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "licenses"]
            }
          }
        },
        {
          "name": "Customer Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "checkout"]
            }
          }
        },
        {
          "name": "Customer Payment Callback (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customer/payment/callback?state={{checkoutState}}&status=success&payment_ref=PAY123&gateway_ref=GW456",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "payment", "callback"],
              "query": [
                { "key": "state", "value": "{{checkoutState}}" },
                { "key": "status", "value": "success" },
                { "key": "payment_ref", "value": "PAY123" },
                { "key": "gateway_ref", "value": "GW456" }
              ]
            }
          }
        },
        {
          "name": "Customer Payment Callback (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/payment/callback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "payment", "callback"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"{{checkoutState}}\",\n  \"status\": \"success\",\n  \"payment_ref\": \"PAY123\",\n  \"gateway_ref\": \"GW456\"\n}"
            }
          }
        }
