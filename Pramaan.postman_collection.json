{
  "info": {
    "name": "Pramaan API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "jwtToken", "value": "" },
    { "key": "apiKey", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "machineId", "value": "3000001" },
    { "key": "machineDbId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "qcResultId", "value": "1" },
    { "key": "healthId", "value": "" },
    { "key": "checkoutState", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tech1\",\n  \"password\": \"password\",\n  \"email\": \"tech1@example.com\",\n  \"company_name\": \"Gadget Guruz\",\n  \"display_name\": \"Tech One\",\n  \"role\": \"Technician\"\n}"
            }
          }
        },
        {
          "name": "License Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/license",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "license"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licenseKey\": \"ABCD-EFGH-IJKL-MNOP\",\n  \"machineSerial\": \"SERIAL123\",\n  \"macAddress\": \"00-11-22-33-44-55\",\n  \"computerName\": \"PRAMAAN-PC\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "QC Results",
      "item": [
        {
          "name": "List QC Results",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qc-results?limit=50&offset=0&machineId={{machineId}}&refurbishId=&overallPass=&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "qc-results"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" },
                { "key": "machineId", "value": "{{machineId}}" },
                { "key": "refurbishId", "value": "" },
                { "key": "overallPass", "value": "" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get QC Result By Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qc-results/{{qcResultId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "qc-results", "{{qcResultId}}"]
            }
          }
        },
        {
          "name": "Submit QC Result (API Key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qc-results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "qc-results"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportId\": \"RPT-001\",\n  \"machineId\": \"{{machineId}}\",\n  \"timestamp\": \"2026-03-26T10:00:00Z\",\n  \"refurbishId\": \"REF-123\",\n  \"technicianNotes\": \"All tests passed\",\n  \"overallPass\": true,\n  \"overallScore\": 92,\n  \"overallGrade\": \"A\",\n  \"technicianId\": 1,\n  \"systemInfo\": {\n    \"manufacturer\": \"Dell\",\n    \"model\": \"Latitude\",\n    \"serialNumber\": \"SERIAL123\",\n    \"macAddress\": \"00-11-22-33-44-55\",\n    \"cpuModel\": \"Intel i5\",\n    \"ramTotal\": 16\n  },\n  \"testResults\": [\n    {\n      \"testType\": \"CPU\",\n      \"tested\": true,\n      \"passed\": true,\n      \"score\": 90,\n      \"grade\": \"A\",\n      \"message\": \"CPU OK\",\n      \"details\": { \"temp\": 65 }\n    }\n  ],\n  \"pramaanScore\": 92,\n  \"healthId\": \"HEALTH-001\",\n  \"pramaanHash\": \"HASH\",\n  \"pramaanGrade\": \"A\",\n  \"pramaanCategoryScores\": {\n    \"storage\": 95,\n    \"thermal\": 90,\n    \"battery\": 88,\n    \"cpu_ram\": 93,\n    \"physical_ports\": 90,\n    \"repair_modifier\": 100\n  },\n  \"pramaanRiskFlags\": {\n    \"storage\": false,\n    \"thermal\": false,\n    \"battery\": false,\n    \"cpu_ram\": false,\n    \"physical_ports\": false,\n    \"repair_modifier\": false\n  },\n  \"pramaanAlgorithmVersion\": \"1.0\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Machines",
      "item": [
        {
          "name": "List Machines",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/machines",
              "host": ["{{baseUrl}}"],
              "path": ["api", "machines"]
            }
          }
        },
        {
          "name": "Get Machine By Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/machines/{{machineDbId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "machines", "{{machineDbId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Licenses",
      "item": [
        {
          "name": "List Licenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/licenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "licenses"]
            }
          }
        },
        {
          "name": "Create License",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/licenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "licenses"]
