            }
          }
        },
        {
          "name": "Toggle License Active",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/licenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "licenses"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"is_active\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Fleet",
      "item": [
        {
          "name": "List Fleet",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/fleet?group_id=&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fleet"],
              "query": [
                { "key": "group_id", "value": "" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Enroll Machine",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/fleet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fleet"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machine_id\": \"{{machineId}}\",\n  \"asset_tag\": \"TAG-001\",\n  \"group_id\": 1,\n  \"serial_number\": \"SERIAL123\",\n  \"manufacturer\": \"Dell\",\n  \"model\": \"Latitude\"\n}"
            }
          }
        },
        {
          "name": "Get Lifecycle Events",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/fleet/{{machineDbId}}/lifecycle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fleet", "{{machineDbId}}", "lifecycle"]
            }
          }
        },
        {
          "name": "Add Lifecycle Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/fleet/{{machineDbId}}/lifecycle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fleet", "{{machineDbId}}", "lifecycle"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"tested\",\n  \"notes\": \"QC passed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=20&search=&role=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "" },
                { "key": "role", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech1@example.com\",\n  \"display_name\": \"Tech One\",\n  \"role\": \"Technician\",\n  \"is_active\": true,\n  \"password\": \"newpassword\",\n  \"license_credits\": 10\n}"
            }
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Customer Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password\",\n  \"fullName\": \"Customer One\"\n}"
            }
          }
        },
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
